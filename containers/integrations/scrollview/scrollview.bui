Private Declare Function ScrollInit Lib "AppKit" Selector "init" (widget As Ptr) As Ptr
Private Declare Function ScrollRetain Lib "AppKit" Selector "retain" (widget As Ptr) As Ptr
Private Declare Function ScrollSuperview Lib "AppKit" Selector "superview" (widget As Ptr) As Ptr
Private Declare Sub ScrollRelease Lib "AppKit" Selector "release" (widget As Ptr)
Private Declare Sub ScrollRemove Lib "AppKit" Selector "removeFromSuperview" (widget As Ptr)
Private Declare Sub ScrollAddSubview Lib "AppKit" Selector "addSubview:" (host As Ptr, widget As Ptr)
Private Declare Sub ScrollAutoresizing Lib "AppKit" Selector "setAutoresizingMask:" (widget As Ptr, mask As Integer)
Private Declare Sub ScrollSetDocument Lib "AppKit" Selector "setDocumentView:" (widget As Ptr, document As Ptr)
Private Declare Sub ScrollHorizontal Lib "AppKit" Selector "setHasHorizontalScroller:" (widget As Ptr, enabled As Boolean)
Private Declare Sub ScrollVertical Lib "AppKit" Selector "setHasVerticalScroller:" (widget As Ptr, enabled As Boolean)
Private Declare Sub ScrollAutohide Lib "AppKit" Selector "setAutohidesScrollers:" (widget As Ptr, enabled As Boolean)
Private Declare Sub ScrollFrame Lib "AppKit" Selector "setFrame:" (widget As Ptr, frame As ScrollRect)
Private Declare Function ScrollContentView Lib "AppKit" Selector "contentView" (widget As Ptr) As Ptr
Private Declare Function ScrollBounds Lib "AppKit" Selector "bounds" (widget As Ptr) As ScrollRect
Private Declare Sub ScrollClip Lib "AppKit" Selector "scrollToPoint:" (widget As Ptr, point As ScrollPoint)
Private Declare Sub ScrollReflect Lib "AppKit" Selector "reflectScrolledClipView:" (widget As Ptr, clip As Ptr)
