' Scoped, session-persistent generic Windows Credential Manager entries.
Public Class GenericCredential
    Public Property UserName As String
    Public Property Secret As Bytes
    Public Property Persistence As Integer
End Class

#If TargetWindows Then
Sequential Structure NativeCredential
    CredentialFlags As UInt32
    CredentialType As UInt32
    TargetName As Ptr
    Comment As Ptr
    WrittenLow As UInt32
    WrittenHigh As UInt32
    BlobSize As UInt32
    Blob As Ptr
    Persistence As UInt32
    AttributeCount As UInt32
    Attributes As Ptr
    TargetAlias As Ptr
    UserName As Ptr
End Structure
Private Optional Declare Function NativeRead Lib "advapi32" Alias "CredReadW" (targetName As Ptr, credentialType As UInt32, reserved As UInt32, ByRef allocated As Ptr) As Int32
Private Optional Declare Function NativeWrite Lib "advapi32" Alias "CredWriteW" (ByRef entry As NativeCredential, reserved As UInt32) As Int32
Private Optional Declare Function NativeDelete Lib "advapi32" Alias "CredDeleteW" (targetName As Ptr, credentialType As UInt32, reserved As UInt32) As Int32
Private Optional Declare Sub NativeFree Lib "advapi32" Alias "CredFree" (entry As Ptr)
Private Optional Declare Function NativeError Lib "kernel32" Alias "GetLastError" () As UInt32
Private Optional Declare Function NativeCopy Lib "c" Alias "memcpy" (ByRef entry As NativeCredential, source As Ptr, count As UInt64) As Ptr
Private Optional Declare Function NativeWideLength Lib "kernel32" Alias "lstrlenW" (wideText As Ptr) As Int32

Private Function CopyWide(wideText As Ptr) As String
    If wideText = Nil Then
        Return ""
    End If
    Dim count As Integer = NativeWideLength(wideText)
    If count < 0 Or count > 32767 Then
        Throw New RuntimeException("Invalid credential text length")
    End If
    Dim encoded As New Bytes(count * 2)
    encoded.Append(wideText, count * 2)
    Return String.FromUTF16LE(encoded)
End Function
#End If

Private Sub RequireWindows()
#If Not TargetWindows Then
    Throw New UnsupportedOperationException("WinCredentials requires Windows")
#End If
End Sub

Private Sub ValidateText(value As String, allowEmpty As Boolean, maximum As Integer)
    If Not allowEmpty And value = "" Then
        Throw New InvalidArgumentException("Credential identifier must be nonempty")
    End If
    Dim encoded As Bytes = Bytes.FromString(value, Text.Encodings.UTF8)
    For i As Integer = 0 To encoded.Count - 1
        If encoded.Item(i) = 0 Then
            Throw New InvalidArgumentException("Credential text cannot contain NUL")
        End If
    Next
    If value.AsUTF16LE().Count > maximum * 2 Then
        Throw New InvalidArgumentException("Credential text exceeds its UTF-16 length limit")
    End If
End Sub

Private Function Wide(value As String) As Bytes
    Dim encoded As Bytes = value.AsUTF16LE()
    encoded.Append(0)
    encoded.Append(0)
    Return encoded
End Function

Private Function Target(applicationName As String, key As String) As Bytes
    ValidateText(applicationName, False, 128)
    ValidateText(key, False, 1024)
    If String.Contains(applicationName, "/") Or String.Contains(applicationName, "\\") Then
        Throw New InvalidArgumentException("Application name cannot contain a path separator")
    End If
    Return Wide("Buoy/" + applicationName + "/" + key)
End Function

Public Function IsSupported() As Boolean
#If TargetWindows Then
    Return True
#Else
    Return False
#End If
End Function

''' None means ERROR_NOT_FOUND; every other native failure is an exception.
Public Function ReadGeneric(applicationName As String, key As String) As Optional Of GenericCredential
    RequireWindows()
    Dim targetName As Bytes = Target(applicationName, key)
#If TargetWindows Then
    ' Resolve the error accessor before the native call can set its error.
    NativeError()
    Dim allocated As Ptr = Nil
    If NativeRead(targetName.DataPtr(), 1, 0, allocated) = 0 Then
        Dim code As Integer = NativeError()
        If code = 1168 Then
            Return None
        End If
        Throw New RuntimeException("CredReadW failed (Win32 error " + Str(code) + ")", code)
    End If
    If allocated = Nil Then
        Throw New RuntimeException("CredReadW returned no credential")
    End If
    Try
        Dim entry As NativeCredential
        NativeCopy(entry, allocated, 80)
        If entry.CredentialType <> 1 Or entry.BlobSize > 2560 Then
            Throw New RuntimeException("Invalid generic credential record")
        End If
        If entry.BlobSize > 0 And entry.Blob = Nil Then
            Throw New RuntimeException("Credential blob pointer is missing")
        End If
        Dim copied As New GenericCredential
        copied.UserName = CopyWide(entry.UserName)
        copied.Persistence = entry.Persistence
        copied.Secret = New Bytes(entry.BlobSize)
        If entry.BlobSize > 0 Then
            copied.Secret.Append(entry.Blob, entry.BlobSize)
        End If
        Return Some(copied)
    Finally
        NativeFree(allocated)
    End Try
#Else
    Return None
#End If
End Function

''' Store binary bytes; session lifetime by default, local-user persistence only by opt-in.
Public Sub StoreGeneric(applicationName As String, key As String, userName As String, secret As Bytes, persistAcrossLogons As Boolean = False)
    RequireWindows()
    Dim targetName As Bytes = Target(applicationName, key)
    ValidateText(userName, True, 513)
    If secret = Nil Then
        Throw New InvalidArgumentException("Secret must be a Bytes instance")
    End If
    If secret.Count > 2560 Then
        Throw New InvalidArgumentException("Credential secret exceeds 2560 bytes")
    End If
#If TargetWindows Then
    Dim wideUser As Bytes = Wide(userName)
    Dim entry As NativeCredential
    entry.CredentialFlags = 0
    entry.CredentialType = 1
    entry.TargetName = targetName.DataPtr()
    entry.Comment = Nil
    entry.WrittenLow = 0
    entry.WrittenHigh = 0
    entry.BlobSize = secret.Count
    entry.Blob = Nil
    If secret.Count > 0 Then
        entry.Blob = secret.DataPtr()
    End If
    entry.Persistence = 1
    If persistAcrossLogons Then
        entry.Persistence = 2
    End If
    entry.AttributeCount = 0
    entry.Attributes = Nil
    entry.TargetAlias = Nil
    entry.UserName = wideUser.DataPtr()
    NativeError()
    If NativeWrite(entry, 0) = 0 Then
        Dim code As Integer = NativeError()
        Throw New RuntimeException("CredWriteW failed (Win32 error " + Str(code) + ")", code)
    End If
#End If
End Sub

''' False means the named generic entry did not exist.
Public Function DeleteGeneric(applicationName As String, key As String) As Boolean
    RequireWindows()
    Dim targetName As Bytes = Target(applicationName, key)
#If TargetWindows Then
    NativeError()
    If NativeDelete(targetName.DataPtr(), 1, 0) <> 0 Then
        Return True
    End If
    Dim code As Integer = NativeError()
    If code = 1168 Then
        Return False
    End If
    Throw New RuntimeException("CredDeleteW failed (Win32 error " + Str(code) + ")", code)
#Else
    Return False
#End If
End Function
