+    ''' immutable once a page uses them, so each distinct pair is created once.
+    Public Function AlphaState(fillKey As Integer, strokeKey As Integer) As Ptr
+        Dim key As Integer = fillKey * (PDFAlphaSteps + 1) + strokeKey
