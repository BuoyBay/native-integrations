+    Private Function EmitPath() As Boolean
+        Dim count As Integer = Array.Count(Me.mPathOps)
+        If count = 0 Then Return False
+        Dim det As Double = Me.mCtmA * Me.mCtmD - Me.mCtmB * Me.mCtmC
+        If det = 0.0 Or Not __pdf_finite(det) Then Return False
+        Dim ia As Double = Me.mCtmD / det
+        Dim ib As Double = -Me.mCtmB / det
+        Dim ic As Double = -Me.mCtmC / det
+        Dim id As Double = Me.mCtmA / det
+        Dim ie As Double = (Me.mCtmC * Me.mCtmF - Me.mCtmD * Me.mCtmE) / det
+        Dim iff As Double = (Me.mCtmB * Me.mCtmE - Me.mCtmA * Me.mCtmF) / det
+        Dim local As Array Of Double = []
+        Dim n As Integer = Array.Count(Me.mPathValues)
+        Dim i As Integer = 0
+        While i < n
+            Dim px As Double = Me.mPathValues(i)
+            Dim py As Double = Me.mPathValues(i + 1)
+            Dim lx As Double = ia * px + ic * py + ie
+            Dim ly As Double = ib * px + id * py + iff
+            If Not (__pdf_finite(lx) And __pdf_finite(ly)) Then Return False
+            Array.Append(local, lx)
+            Array.Append(local, ly)
+            i += 2
+        End While
+        Dim emitted As Boolean = False
+        Dim hasPoint As Boolean = False
+        Dim v As Integer = 0
