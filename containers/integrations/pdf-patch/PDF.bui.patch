+' The patched Windows pdf.dll adds these four existing libharu functions to
+' its export table; Linux and macOS already export them.
+Declare Function HPDF_CreateExtGState Lib "pdf" (pdf As Ptr) As Ptr
+#If TargetWindows Then
+    Declare Function HPDF_ExtGState_SetAlphaFill   Lib "pdf" (ext As Ptr, value As Single) As UInt32
+    Declare Function HPDF_ExtGState_SetAlphaStroke Lib "pdf" (ext As Ptr, value As Single) As UInt32
+    Declare Function HPDF_Page_SetExtGState        Lib "pdf" (page As Ptr, ext As Ptr) As UInt32
+#Else
+    Declare Function HPDF_ExtGState_SetAlphaFill   Lib "pdf" (ext As Ptr, value As Single) As UInt64
+    Declare Function HPDF_ExtGState_SetAlphaStroke Lib "pdf" (ext As Ptr, value As Single) As UInt64
+    Declare Function HPDF_Page_SetExtGState        Lib "pdf" (page As Ptr, ext As Ptr) As UInt64
+#End If
+
+' Alpha is quantized to 1/10000 so equal colours share one ExtGState.
+Const PDFAlphaSteps As Integer = 10000
+
+Private Function __pdf_alpha_key(alpha As Double) As Integer
+    If Not (alpha - alpha = 0.0) Then Return PDFAlphaSteps
+    If alpha <= 0.0 Then Return 0
+    If alpha >= 1.0 Then Return PDFAlphaSteps
+    Dim key As Integer = Math.Round(alpha * 10000.0)
+    Return key
+End Function
+
+Private Function __pdf_finite(v As Double) As Boolean
+    Return v - v = 0.0
+End Function
