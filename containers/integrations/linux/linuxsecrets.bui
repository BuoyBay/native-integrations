' Scoped Secret Service passwords through libsecret. No native handles escape.
#If TargetLinux Then
Private Optional Declare Function NativeHash Lib "libglib-2.0.so.0" Alias "g_str_hash" (value As CString) As UInt32
Private Optional Declare Function NativeEqual Lib "libglib-2.0.so.0" Alias "g_str_equal" (left As CString, right As CString) As Int32
Private Optional Declare Sub SecretFree Lib "libglib-2.0.so.0" Alias "g_free" (value As Ptr)
Private Optional Declare Function NativeDup Lib "libglib-2.0.so.0" Alias "g_strdup" (value As CString) As Ptr
Private Optional Declare Function NativeTable Lib "libglib-2.0.so.0" Alias "g_hash_table_new_full" (hash As Ptr, equal As Ptr, freeKey As Ptr, freeValue As Ptr) As Ptr
Private Optional Declare Function NativeInsert Lib "libglib-2.0.so.0" Alias "g_hash_table_insert" (table As Ptr, key As Ptr, value As Ptr) As Int32
Private Optional Declare Sub NativeDestroy Lib "libglib-2.0.so.0" Alias "g_hash_table_unref" (table As Ptr)
Private Optional Declare Sub NativeErrorFree Lib "libglib-2.0.so.0" Alias "g_error_free" (error As Ptr)
Private Optional Declare Function NativeStore Lib "libsecret-1.so.0" Alias "secret_password_storev_sync" (schema As Ptr, attributes As Ptr, collection As CString, label As CString, password As CString, cancellable As Ptr, ByRef error As Ptr) As Int32
Private Optional Declare Function NativeLookup Lib "libsecret-1.so.0" Alias "secret_password_lookupv_sync" (schema As Ptr, attributes As Ptr, cancellable As Ptr, ByRef error As Ptr) As CString
Private Optional Declare Function NativeClear Lib "libsecret-1.so.0" Alias "secret_password_clearv_sync" (schema As Ptr, attributes As Ptr, cancellable As Ptr, ByRef error As Ptr) As Int32
Private Optional Declare Sub NativePasswordFree Lib "libsecret-1.so.0" Alias "secret_password_free" (password As CString)

Sequential Structure NativeErrorRecord
    Domain As UInt32
    Code As Int32
    Message As Ptr
End Structure
Private Optional Declare Function NativeCopyError Lib "c" Alias "memcpy" (ByRef destination As NativeErrorRecord, source As Ptr, count As UInt64) As Ptr

Private Sub CheckError(error As Ptr)
    If error <> Nil Then
        Dim info As NativeErrorRecord
        Try
            NativeCopyError(info, error, 16)
        Finally
            NativeErrorFree(error)
        End Try
        ' Do not expose native error text, labels, keys or password content.
        Throw New RuntimeException("Secret Service operation failed (GError domain " + Str(info.Domain) + ", code " + Str(info.Code) + ")", info.Code)
    End If
End Sub

Private Function Attributes(application As String, key As String) As Ptr
    Dim table As Ptr = NativeTable(CType(AddressOf NativeHash, Ptr), CType(AddressOf NativeEqual, Ptr), CType(AddressOf SecretFree, Ptr), CType(AddressOf SecretFree, Ptr))
    If table = Nil Then
        Throw New RuntimeException("Unable to allocate secret attributes")
    End If
    Try
        NativeInsert(table, NativeDup(CType("xdg:schema", CString)), NativeDup(CType("org.buoy.Integrations.Password", CString)))
        NativeInsert(table, NativeDup(CType("buoy-application", CString)), NativeDup(CType(application, CString)))
        NativeInsert(table, NativeDup(CType("buoy-key", CString)), NativeDup(CType(key, CString)))
        Return table
    Catch e As Exception
        NativeDestroy(table)
        Throw e
    End Try
End Function
#End If

Private Sub RequireLinux()
#If Not TargetLinux Then
    Throw New UnsupportedOperationException("linuxsecrets requires Linux")
#End If
End Sub

Private Sub ValidateText(value As String, allowEmpty As Boolean)
    If Not allowEmpty And value = "" Then
        Throw New InvalidArgumentException("Secret application, key and label must be nonempty")
    End If
    Dim encoded As Bytes = Bytes.FromString(value, Text.Encodings.UTF8)
    For i As Integer = 0 To encoded.Count - 1
        If encoded.Item(i) = 0 Then
            Throw New InvalidArgumentException("Secret text cannot contain NUL")
        End If
    Next
End Sub

Public Function IsSupported() As Boolean
#If TargetLinux Then
    Return True
#Else
    Return False
#End If
End Function

''' Library discovery only: does not connect, prompt, unlock or test a keyring.
Public Function IsAvailable() As Boolean
#If TargetLinux Then
    Return System.IsLibraryAvailable("libsecret-1.so.0") And System.IsLibraryAvailable("libglib-2.0.so.0")
#Else
    Return False
#End If
End Function

''' May block or prompt through the desktop keyring; do not call on a UI thread.
Public Sub Store(application As String, key As String, label As String, password As String, sessionOnly As Boolean = False)
    RequireLinux()
    ValidateText(application, False)
    ValidateText(key, False)
    ValidateText(label, False)
    ValidateText(password, True)
#If TargetLinux Then
    Dim table As Ptr = Attributes(application, key)
    Try
        Dim collection As String = "default"
        If sessionOnly Then
            collection = "session"
        End If
        Dim error As Ptr = Nil
        Dim status As Int32 = NativeStore(Nil, table, CType(collection, CString), CType(label, CString), CType(password, CString), Nil, error)
        CheckError(error)
        If status = 0 Then
            Throw New RuntimeException("Secret Service did not store the password")
        End If
    Finally
        NativeDestroy(table)
    End Try
#End If
End Sub

''' None means no matching password returned; Some("") preserves an empty password.
Public Function Lookup(application As String, key As String) As Optional Of String
    RequireLinux()
    ValidateText(application, False)
    ValidateText(key, False)
#If TargetLinux Then
    Dim table As Ptr = Attributes(application, key)
    Try
        Dim error As Ptr = Nil
        Dim password As CString = NativeLookup(Nil, table, Nil, error)
        Try
            CheckError(error)
            If password = Nil Then
                Return None
            End If
            Return Some(CType(password, String))
        Finally
            If password <> Nil Then
                NativePasswordFree(password)
            End If
        End Try
    Finally
        NativeDestroy(table)
    End Try
#Else
    Return None
#End If
End Function

''' Clear all unlocked entries matching this exact module namespace/application/key.
Public Function Clear(application As String, key As String) As Boolean
    RequireLinux()
    ValidateText(application, False)
    ValidateText(key, False)
#If TargetLinux Then
    Dim table As Ptr = Attributes(application, key)
    Try
        Dim error As Ptr = Nil
        Dim status As Int32 = NativeClear(Nil, table, Nil, error)
        CheckError(error)
        Return status <> 0
    Finally
        NativeDestroy(table)
    End Try
#Else
    Return False
#End If
End Function
