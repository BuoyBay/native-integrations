Private Optional Declare Function PopoverFloating Lib "libgobject-2.0.so.0" Alias "g_object_is_floating" (widget As Ptr) As Int32
Private Optional Declare Sub PopoverUnref Lib "libgobject-2.0.so.0" Alias "g_object_unref" (widget As Ptr)
