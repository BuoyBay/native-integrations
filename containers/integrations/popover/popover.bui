Private Optional Declare Sub PopoverAutohide Lib "libgtk-4.so.1" Alias "gtk_popover_set_autohide" (widget As Ptr, enabled As Int32)
Private Optional Declare Sub PopoverPosition Lib "libgtk-4.so.1" Alias "gtk_popover_set_position" (widget As Ptr, position As Int32)
Private Optional Declare Sub PopoverSetParent Lib "libgtk-4.so.1" Alias "gtk_widget_set_parent" (widget As Ptr, parent As Ptr)
Private Optional Declare Function PopoverIsAncestor Lib "libgtk-4.so.1" Alias "gtk_widget_is_ancestor" (widget As Ptr, ancestor As Ptr) As Int32
Private Optional Declare Function PopoverParent Lib "libgtk-4.so.1" Alias "gtk_widget_get_parent" (widget As Ptr) As Ptr
Private Optional Declare Sub PopoverUnparent Lib "libgtk-4.so.1" Alias "gtk_widget_unparent" (widget As Ptr)
Private Optional Declare Function PopoverMapped Lib "libgtk-4.so.1" Alias "gtk_widget_get_mapped" (widget As Ptr) As Int32
Private Optional Declare Function PopoverRoot Lib "libgtk-4.so.1" Alias "gtk_widget_get_root" (widget As Ptr) As Ptr
Private Optional Declare Sub PopoverPointTo Lib "libgtk-4.so.1" Alias "gtk_popover_set_pointing_to" (widget As Ptr, ByRef location As PopoverRectangle)
Private Optional Declare Sub PopoverPopup Lib "libgtk-4.so.1" Alias "gtk_popover_popup" (widget As Ptr)
Private Optional Declare Sub PopoverPopdown Lib "libgtk-4.so.1" Alias "gtk_popover_popdown" (widget As Ptr)
Private Optional Declare Sub PopoverSize Lib "libgtk-4.so.1" Alias "gtk_widget_set_size_request" (widget As Ptr, width As Int32, height As Int32)
Private Optional Declare Function PopoverGrabFocus Lib "libgtk-4.so.1" Alias "gtk_widget_grab_focus" (widget As Ptr) As Int32
Private Optional Declare Function PopoverConnect Lib "libgobject-2.0.so.0" Alias "g_signal_connect_data" (widget As Ptr, signal As String, callback As PopoverLinuxClosedCallback, data As Ptr, destroy As Ptr, nativeFlags As Int32) As UInt64
Private Optional Declare Sub PopoverDisconnect Lib "libgobject-2.0.so.0" Alias "g_signal_handler_disconnect" (widget As Ptr, signal As UInt64)
Private Sub PopoverLinuxClosed(widget As Ptr, data As Ptr)
    Dim owner As NativePopover = PopoverFind(data)
    If owner <> Nil Then owner.NativeDismissed(widget)
End Sub
#ElseIf TargetWindows Then
