Private Function PopoverUTF16(value As String) As Bytes
    Dim buffer As Bytes = value.AsUTF16LE()
    buffer.Append(0)
    buffer.Append(0)
    Return buffer
End Function
Private Function PopoverWindowsMessage(widget As Ptr, message As UInt32, word As UInt64, param As Int64, id As UInt64, data As UInt64) As Int64
    Dim callbackID As Integer = id
    Dim owner As NativePopover = PopoverFind(CType(callbackID, Ptr))
    If owner <> Nil Then
        If message = 6 And (word And 65535) = 0 Then owner.NativeDismissed(widget) ' WM_ACTIVATE / WA_INACTIVE
        If message = 16 Then
            owner.NativeEscape()
            Return 0
        End If
        If message = 273 And param <> 0 Then
            Dim address As Integer = param
            Dim parent As Ptr = PopoverParentWindow(CType(address, Ptr))
            If parent <> Nil And parent <> widget Then Return PopoverSend(parent, message, word, param)
        End If
    End If
    Return PopoverDefault(widget, message, word, param)
End Function
Private Function PopoverWindowsKeys(code As Int32, word As UInt64, param As Ptr) As Int64
    If code >= 0 And word = 1 And param <> Nil Then
        Dim message As PopoverMessage
        PopoverCopy(CType(message, Ptr), param, 48)
        If message.Message = 256 Then
            For Each reference As PopoverReference In PopoverRegistry.Items
                Dim owner As NativePopover = reference.Owner
                If owner = Nil Then Continue For
                If Not owner.IsOpen Then Continue For
                If PopoverAncestor(message.Window, 2) <> owner.NativeHandle Then Continue For
                Dim handled As Boolean = False
                If message.Word = 27 Then
                    owner.NativeEscape()
                    handled = True
                ElseIf message.Word = 9 Or message.Word = 13 Then
                    handled = PopoverDialogMessage(owner.NativeHandle, param) <> 0
                End If
                If handled Then
                    message.Message = 0
                    PopoverCopy(param, CType(message, Ptr), 48)
                    Exit For
                End If
            Next
        End If
    End If
    Return PopoverNextHook(Nil, code, word, param)
End Function
