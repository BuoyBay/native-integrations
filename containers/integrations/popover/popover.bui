' Native arbitrary-content flyout; all calls belong on the GUI thread.
Private Class PopoverReference
    Public Property Owner As Weak NativePopover
End Class
Private Class PopoverRegistry
    Public Shared Property Items As Array Of PopoverReference = []
End Class

Public Class NativePopover
    Event Dismissed()
    Private Property mContent As View
    Private Property mOwner As Weak UIControl
    Private Property mRoot As Ptr = Nil
    Private Property mID As Integer = -1
    Private Property mIsOpen As Boolean = False
    Private Property mClosed As Boolean = False
    Private Property mWidth As Integer
    Private Property mHeight As Integer
    Public Property LastNativeError As String = ""
    #If TargetLinux Then
        Private Property mClosedSignal As UInt64 = 0
    #ElseIf TargetWindows Then
        Private Property mStaging As Window
        Private Property mHook As Ptr = Nil
        Private Property mContentStyle As Int64 = 0
    #ElseIf TargetMac Then
        Private Property mController As Ptr = Nil
    #End If

    Public Sub Constructor(width As Integer = 280, height As Integer = 160)
        Me.ValidateSize(width, height)
        Me.mWidth = width
        Me.mHeight = height
        Me.mContent = New View()
        Me.mContent.Move(0, 0, width, height)
        #If TargetLinux Then
            ' Buoy owns unparented views; sink its initial floating reference so
            ' detaching the popover child preserves the View until Buoy frees it.
            If PopoverFloating(Me.mContent.NativeWidget) <> 0 Then PopoverRefSink(Me.mContent.NativeWidget)
        #End If
    End Sub
    Public Property Content As View
        Get
            Return Me.mContent
        End Get
    End Property
    Public Property IsOpen As Boolean
        Get
            Return Me.mIsOpen
        End Get
    End Property
    Public Property IsClosed As Boolean
        Get
            Return Me.mClosed
        End Get
    End Property
    Public Property NativeHandle As Ptr
        Get
            Return Me.mRoot
        End Get
    End Property
    Private Sub ValidateSize(width As Integer, height As Integer)
        If width <= 0 Or height <= 0 Or width > 10000 Or height > 10000 Then Throw New InvalidArgumentException("Popover dimensions must be 1...10000 points")
    End Sub
    Public Sub Resize(width As Integer, height As Integer)
        If Me.mClosed Then Throw New InvalidArgumentException("Popover is closed")
        Me.ValidateSize(width, height)
        Me.mWidth = width
        Me.mHeight = height
        Me.mContent.Move(0, 0, width, height)
        If Me.mRoot <> Nil Then Me.ApplySize()
    End Sub
    ' The anchor rectangle is in the owner's local graphics points.
    Public Sub Show(owner As UIControl, anchor As Rect)
        If Me.mClosed Then Throw New InvalidArgumentException("Popover is closed")
        If owner = Nil Or anchor = Nil Then Throw New InvalidArgumentException("Popover requires an owner and anchor")
        If anchor.Left <> anchor.Left Or anchor.Top <> anchor.Top Or anchor.Width <> anchor.Width Or anchor.Height <> anchor.Height Then Throw New InvalidArgumentException("Invalid popover anchor")
        If Math.Abs(anchor.Left) > 100000 Or Math.Abs(anchor.Top) > 100000 Or anchor.Width <= 0 Or anchor.Height <= 0 Or anchor.Width > 100000 Or anchor.Height > 100000 Then Throw New InvalidArgumentException("Invalid popover anchor")
        If owner.NativeWidget = Nil Then Throw New InvalidArgumentException("Popover owner has no native widget")
        If owner.NativeWidget = Me.mContent.NativeWidget Then Throw New InvalidArgumentException("Popover cannot anchor to its own content")
        #If TargetLinux Then
            If PopoverIsAncestor(owner.NativeWidget, Me.mContent.NativeWidget) <> 0 Then Throw New InvalidArgumentException("Popover cannot anchor inside its own content")
            If Me.mRoot = Nil And PopoverParent(Me.mContent.NativeWidget) <> Nil Then Throw New InvalidArgumentException("Do not attach popover Content to another container")
        #ElseIf TargetWindows Then
            If Me.mContent.NativeWidget <> Nil Then
                If PopoverIsChild(Me.mContent.NativeWidget, owner.NativeWidget) <> 0 Then Throw New InvalidArgumentException("Popover cannot anchor inside its own content")
                If Me.mStaging = Nil Then Throw New InvalidArgumentException("Do not attach popover Content to another container")
            End If
        #ElseIf TargetMac Then
            If PopoverDescendant(owner.NativeWidget, Me.mContent.NativeWidget) Then Throw New InvalidArgumentException("Popover cannot anchor inside its own content")
            If Me.mRoot = Nil And PopoverSuperview(Me.mContent.NativeWidget) <> Nil Then Throw New InvalidArgumentException("Do not attach popover Content to another container")
        #End If
        If Not owner.Visible Or Not owner.Enabled Then Return
        Me.Dismiss()
        If Me.mClosed Then Return
        Me.LastNativeError = ""
        Me.mOwner = owner
        Me.EnsureNative()
        Me.ApplySize()
        Try
            #If TargetLinux Then
                If PopoverRoot(owner.NativeWidget) = Nil Or PopoverMapped(owner.NativeWidget) = 0 Then Throw New InvalidArgumentException("Attach owner to a visible window before showing popover")
                Dim parent As Ptr = PopoverParent(Me.mRoot)
                If parent <> owner.NativeWidget Then
                    If parent <> Nil Then PopoverUnparent(Me.mRoot)
                    PopoverSetParent(Me.mRoot, owner.NativeWidget)
                End If
                Dim location As PopoverRectangle
                location.X = Math.Round(anchor.Left)
                location.Y = Math.Round(anchor.Top)
                location.Width = Math.Max(1, Math.Round(anchor.Width))
                location.Height = Math.Max(1, Math.Round(anchor.Height))
                PopoverPointTo(Me.mRoot, location)
                Me.mIsOpen = True
                PopoverPopup(Me.mRoot)
            #ElseIf TargetWindows Then
                If PopoverIsWindow(owner.NativeWidget) = 0 Or PopoverVisible(owner.NativeWidget) = 0 Then Throw New InvalidArgumentException("Attach owner to a visible window before showing popover")
                Dim topWindow As Ptr = PopoverAncestor(owner.NativeWidget, 2)
                PopoverSetLong(Me.mRoot, -8, CType(topWindow, Integer)) ' GWLP_HWNDPARENT
                Dim scale As Double = PopoverDPI(owner.NativeWidget) / 96.0
                Dim location As PopoverPoint
                location.X = anchor.Left * scale
                location.Y = anchor.Bottom * scale
                PopoverToScreen(owner.NativeWidget, location)
                Dim width As Integer = Me.mWidth * scale
                Dim height As Integer = Me.mHeight * scale
                Dim work As PopoverWorkArea
                work.Size = 40
                If PopoverMonitorInfo(PopoverMonitor(owner.NativeWidget, 2), work) <> 0 Then
                    Dim leftLimit As Integer = work.WorkLeft
                    Dim rightLimit As Integer = work.WorkRight
                    Dim topLimit As Integer = work.WorkTop
                    Dim bottomLimit As Integer = work.WorkBottom
                    If location.X + width + 2 > rightLimit Then location.X = Math.Max(leftLimit, rightLimit - width - 2)
                    If location.Y + height + 2 > bottomLimit Then
                        Dim above As Integer = location.Y - height - anchor.Height * scale
                        location.Y = Math.Max(topLimit, above)
                    End If
                End If
                PopoverMove(Me.mRoot, location.X, location.Y, width + 2, height + 2, 1)
                PopoverMove(Me.mContent.NativeWidget, 0, 0, width, height, 1)
                Me.mIsOpen = True
                PopoverShow(Me.mRoot, 5)
                PopoverForeground(Me.mRoot)
                Dim first As Ptr = PopoverNextTab(Me.mRoot, Nil, 0)
                If first <> Nil Then PopoverFocus(first)
            #ElseIf TargetMac Then
                Dim ownerWindow As Ptr = PopoverWindow(owner.NativeWidget)
                If ownerWindow = Nil Then Throw New InvalidArgumentException("Attach owner before showing popover")
                If Not PopoverMacVisible(ownerWindow) Or PopoverMacHidden(owner.NativeWidget) Then Throw New InvalidArgumentException("Popover owner must be visible")
                Dim location As PopoverMacRect
                location.X = anchor.Left
                location.Y = anchor.Top
                location.Width = anchor.Width
                location.Height = anchor.Height
                Me.mIsOpen = True
                PopoverMacShow(Me.mRoot, location, owner.NativeWidget, 3)
            #End If
        Catch e As Exception
            Me.mIsOpen = False
            Me.LastNativeError = e.Message
            Throw e
        End Try
    End Sub
    Public Sub Dismiss()
        If Not Me.mIsOpen Then Return
        Me.mIsOpen = False
        #If TargetLinux Then
            PopoverPopdown(Me.mRoot)
        #ElseIf TargetWindows Then
            PopoverShow(Me.mRoot, 0)
        #ElseIf TargetMac Then
            PopoverMacClose(Me.mRoot)
        #End If
        Me.RestoreFocus()
        RaiseEvent Dismissed()
    End Sub
    ' Terminal cleanup. Populate a new instance to use another content tree.
    Public Sub Close()
        If Me.mClosed Then Return
        Me.mClosed = True
        Me.mIsOpen = False
        If Me.mID >= 0 Then PopoverRegistry.Items(Me.mID).Owner = Nil
        #If TargetLinux Then
            If Me.mRoot <> Nil Then
                If Me.mClosedSignal <> 0 Then PopoverDisconnect(Me.mRoot, Me.mClosedSignal)
                PopoverPopdown(Me.mRoot)
                PopoverSetChild(Me.mRoot, Nil)
                If PopoverParent(Me.mRoot) <> Nil Then PopoverUnparent(Me.mRoot)
                PopoverUnref(Me.mRoot)
            End If
            Me.mClosedSignal = 0
        #ElseIf TargetWindows Then
            If Me.mHook <> Nil Then PopoverUnhook(Me.mHook)
            Me.mHook = Nil
            If Me.mRoot <> Nil Then
                PopoverRemoveSubclass(Me.mRoot, AddressOf PopoverWindowsMessage, Me.mID + 1)
                If Me.mContent <> Nil And Me.mStaging <> Nil Then
                    If PopoverIsWindow(Me.mContent.NativeWidget) <> 0 Then
                        PopoverSetParentWindow(Me.mContent.NativeWidget, Me.mStaging.NativeWidget)
                        PopoverSetLong(Me.mContent.NativeWidget, -20, Me.mContentStyle)
                    End If
                End If
                PopoverDestroy(Me.mRoot)
            End If
            If Me.mStaging <> Nil Then Me.mStaging.Close()
            Me.mStaging = Nil
        #ElseIf TargetMac Then
            If Me.mRoot <> Nil Then
                PopoverMacDelegate(Me.mRoot, Nil)
                PopoverMacClose(Me.mRoot)
                PopoverMacContent(Me.mRoot, Nil)
                PopoverMacRelease(Me.mRoot)
            End If
            If Me.mController <> Nil Then PopoverMacRelease(Me.mController)
            Me.mController = Nil
        #End If
        Me.mRoot = Nil
        Me.mID = -1
        Me.mOwner = Nil
        Me.mContent = Nil
    End Sub
    Public Sub Destructor()
        Me.Close()
    End Sub
    Private Sub RestoreFocus()
        Dim owner As UIControl = Me.mOwner
        If owner = Nil Then Return
        Dim widget As Ptr = owner.NativeWidget
        If widget = Nil Then Return
        #If TargetLinux Then
            If PopoverRoot(widget) <> Nil Then PopoverGrabFocus(widget)
        #ElseIf TargetWindows Then
            If PopoverIsWindow(widget) <> 0 Then PopoverFocus(widget)
        #ElseIf TargetMac Then
            Dim window As Ptr = PopoverWindow(widget)
            If window <> Nil Then PopoverFirstResponder(window, widget)
        #End If
    End Sub
    Private Sub EnsureNative()
        If Me.mRoot <> Nil Then Return
        For i As Integer = 0 To Array.LastIndex(PopoverRegistry.Items)
            If PopoverRegistry.Items(i).Owner = Nil Then
                Me.mID = i
                Exit For
            End If
        Next
        If Me.mID < 0 Then
            Me.mID = Array.Count(PopoverRegistry.Items)
            Array.Append(PopoverRegistry.Items, New PopoverReference())
        End If
        PopoverRegistry.Items(Me.mID).Owner = Me
        Try
            #If TargetLinux Then
                Me.mRoot = PopoverNew()
                PopoverRefSink(Me.mRoot)
                PopoverSetChild(Me.mRoot, Me.mContent.NativeWidget)
                PopoverAutohide(Me.mRoot, 1)
                PopoverPosition(Me.mRoot, 3) ' GTK_POS_BOTTOM
                Me.mClosedSignal = PopoverConnect(Me.mRoot, "closed", AddressOf PopoverLinuxClosed, CType(Me.mID + 1, Ptr), Nil, 0)
            #ElseIf TargetWindows Then
                Me.mStaging = New Window()
                Me.mStaging.Move(0, 0, Me.mWidth, Me.mHeight)
                Me.mStaging.AddSubview(Me.mContent)
                Dim cls As Bytes = PopoverUTF16("STATIC")
                ' WS_EX_TOOLWINDOW | WS_EX_CONTROLPARENT; WS_POPUP | WS_BORDER | WS_CLIPCHILDREN
                Me.mRoot = PopoverCreate(65664, cls.DataPtr(), Nil, 2189426688, 0, 0, 1, 1, Nil, Nil, Nil, Nil)
                If Me.mRoot = Nil Then Throw New RuntimeException("Could not create native flyout window")
                Me.mContentStyle = PopoverGetLong(Me.mContent.NativeWidget, -20)
                PopoverSetLong(Me.mContent.NativeWidget, -20, Me.mContentStyle Or 65536)
                PopoverSetParentWindow(Me.mContent.NativeWidget, Me.mRoot)
                If PopoverSubclass(Me.mRoot, AddressOf PopoverWindowsMessage, Me.mID + 1, 0) = 0 Then Throw New RuntimeException("Could not bind native flyout")
                Me.mHook = PopoverHook(3, AddressOf PopoverWindowsKeys, Nil, PopoverThread())
                If Me.mHook = Nil Then Throw New RuntimeException("Could not bind flyout keyboard")
            #ElseIf TargetMac Then
                Me.mRoot = PopoverMacInit(PopoverMacAlloc(PopoverMacClass()))
                Me.mController = PopoverMacInit(PopoverMacAlloc(PopoverGetClass("NSViewController")))
                PopoverControllerView(Me.mController, Me.mContent.NativeWidget)
                PopoverMacContent(Me.mRoot, Me.mController)
                PopoverMacBehavior(Me.mRoot, 1) ' NSPopoverBehaviorTransient
                PopoverMacAnimates(Me.mRoot, False)
                PopoverMacDelegate(Me.mRoot, Me.mRoot)
            #End If
        Catch e As Exception
            Me.LastNativeError = e.Message
            Me.Close()
            Throw e
        End Try
    End Sub
    Private Sub ApplySize()
        #If TargetLinux Then
            PopoverSize(Me.mContent.NativeWidget, Me.mWidth, Me.mHeight)
        #ElseIf TargetWindows Then
            Dim scale As Double = PopoverDPI(Me.mRoot) / 96.0
            Dim width As Integer = Me.mWidth * scale
            Dim height As Integer = Me.mHeight * scale
            PopoverMove(Me.mContent.NativeWidget, 0, 0, width, height, 1)
            PopoverSetPosition(Me.mRoot, Nil, 0, 0, width + 2, height + 2, 22)
        #ElseIf TargetMac Then
            Dim size As PopoverMacSize
            size.Width = Me.mWidth
            size.Height = Me.mHeight
            PopoverMacSizeSet(Me.mRoot, size)
        #End If
    End Sub
    ' Native callbacks contain user exceptions before returning to the OS.
    Public Sub NativeDismissed(widget As Ptr)
        If widget <> Me.mRoot Or Not Me.mIsOpen Then Return
        Me.mIsOpen = False
        #If TargetWindows Then
            PopoverShow(Me.mRoot, 0)
        #End If
        Try
            RaiseEvent Dismissed()
        Catch e As Exception
            Me.LastNativeError = e.Message
        End Try
    End Sub
    Public Sub NativeEscape()
        Try
            Me.Dismiss()
        Catch e As Exception
            Me.LastNativeError = e.Message
        End Try
    End Sub
End Class

Private Function PopoverFind(data As Ptr) As NativePopover
    Dim index As Integer = CType(data, Integer) - 1
    If index < 0 Or index >= Array.Count(PopoverRegistry.Items) Then Return Nil
    Return PopoverRegistry.Items(index).Owner
End Function

#If TargetLinux Then
Sequential Structure PopoverRectangle
    X As Int32
    Y As Int32
    Width As Int32
    Height As Int32
End Structure
Delegate Sub PopoverLinuxClosedCallback(widget As Ptr, data As Ptr)
