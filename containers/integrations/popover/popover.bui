Private Function PopoverMacClass() As Ptr
    Dim cls As Ptr = PopoverGetClass("BuoyNativePopover")
    If cls <> Nil Then Return cls
    cls = PopoverAllocateClass(PopoverGetClass("NSPopover"), "BuoyNativePopover", 0)
    If cls = Nil Then Throw New RuntimeException("Could not allocate native popover class")
    Dim callback As PopoverMacClosedCallback = AddressOf PopoverMacClosed
    If PopoverAddMethod(cls, PopoverSelector("popoverDidClose:"), CType(callback, Ptr), "v@:@") = 0 Then Throw New RuntimeException("Could not bind native popover dismissal")
    PopoverRegisterClass(cls)
    Return cls
End Function
Private Sub PopoverMacClosed(receiver As Ptr, methodSelector As Ptr, notification As Ptr)
    For Each reference As PopoverReference In PopoverRegistry.Items
        Dim owner As NativePopover = reference.Owner
        If owner <> Nil Then owner.NativeDismissed(receiver)
    Next
End Sub
#End If
