Private Delegate Sub TreeKeyboardCallback(receiver As Ptr, methodSelector As Ptr, nativeEvent As Ptr)
Private Sub TreeMacKeyboard(receiver As Ptr, methodSelector As Ptr, nativeEvent As Ptr)
    For Each reference As TreeReference In TreeRegistry.Items
        Dim owner As TreeView = reference.Owner
        If owner <> Nil Then
            If owner.OwnsContextOutline(receiver) Then
                Try
                    Dim name As String = ""
                    Select Case MacKeyboardCode(nativeEvent)
                        Case 120
                            name = "F2"
                        Case 109
                            name = "F10"
                        Case 2
                            name = "D"
                        Case 36, 76
                            name = "Return"
                    End Select
                    Dim modifiers As UInt64 = MacKeyboardModifiers(nativeEvent)
                    Dim primary As Boolean = (modifiers And 1048576) <> 0
                    Dim shift As Boolean = (modifiers And 131072) <> 0
                    Dim alt As Boolean = (modifiers And 524288) <> 0 Or (modifiers And 262144) <> 0
                    If owner.NavigationKey(name, primary, shift, alt) Then Return
                Catch e As Exception
                    owner.LastNativeError = e.Message
                End Try
                Exit For
            End If
        End If
    Next
    Dim parent As TreeKeyboardSuper
    parent.Receiver = receiver
    parent.ParentClass = MacClass("NSOutlineView")
    MacKeyboardSuper(parent, methodSelector, nativeEvent)
End Sub
Private Function TreeContextOutlineClass() As Ptr
    Dim cls As Ptr = MacClass("BuoyContextOutlineView")
    If cls <> Nil Then Return cls
    cls = MacAllocateClass(MacClass("NSOutlineView"), "BuoyContextOutlineView", 0)
    Dim callback As TreeContextCallback = AddressOf TreeMacContext
    If MacAddMethod(cls, MacSelector("menuForEvent:"), CType(callback, Ptr), "@@:@") = 0 Then Throw New RuntimeException("Could not register tree context menu")
    Dim keyCallback As TreeKeyboardCallback = AddressOf TreeMacKeyboard
    If MacAddMethod(cls, MacSelector("keyDown:"), CType(keyCallback, Ptr), "v@:@") = 0 Then Throw New RuntimeException("Could not register tree keyboard handler")
    MacRegisterClass(cls)
    Return cls
End Function
Private Function TreeMacContext(receiver As Ptr, methodSelector As Ptr, nativeEvent As Ptr) As Ptr
    For Each reference As TreeReference In TreeRegistry.Items
        Dim owner As TreeView = reference.Owner
        If owner <> Nil Then
            If owner.OwnsContextOutline(receiver) Then
                Try
                    owner.MacContext(nativeEvent)
                Catch e As Exception
                    owner.LastNativeError = e.Message
                End Try
                Return Nil
            End If
        End If
    Next
    Return Nil
End Function
Private Function TreeMacBridgeClass() As Ptr
    Dim cls As Ptr = MacClass("BuoyNativeTreeDataSource")
    If cls <> Nil Then Return cls
    cls = MacAllocateClass(MacClass("NSObject"), "BuoyNativeTreeDataSource", 0)
    If cls = Nil Then Throw New RuntimeException("Could not allocate outline data source")
    Dim count As TreeMacCount = AddressOf TreeMacNumber
    Dim child As TreeMacChild = AddressOf TreeMacGetChild
    Dim expandable As TreeMacExpandable = AddressOf TreeMacCanExpand
    Dim value As TreeMacValue = AddressOf TreeMacGetValue
    Dim selected As TreeMacNotification = AddressOf TreeMacSelected
    Dim expanded As TreeMacNotification = AddressOf TreeMacExpanded
    If MacAddMethod(cls, MacSelector("outlineView:numberOfChildrenOfItem:"), CType(count, Ptr), "q@:@@") = 0 Then Throw New RuntimeException("Could not register outline count")
    If MacAddMethod(cls, MacSelector("outlineView:child:ofItem:"), CType(child, Ptr), "@@:@q@") = 0 Then Throw New RuntimeException("Could not register outline child")
    If MacAddMethod(cls, MacSelector("outlineView:isItemExpandable:"), CType(expandable, Ptr), "C@:@@") = 0 Then Throw New RuntimeException("Could not register outline expandability")
    If MacAddMethod(cls, MacSelector("outlineView:objectValueForTableColumn:byItem:"), CType(value, Ptr), "@@:@@@") = 0 Then Throw New RuntimeException("Could not register outline caption")
    If MacAddMethod(cls, MacSelector("outlineViewSelectionDidChange:"), CType(selected, Ptr), "v@:@") = 0 Then Throw New RuntimeException("Could not register outline selection")
    If MacAddMethod(cls, MacSelector("outlineViewItemDidExpand:"), CType(expanded, Ptr), "v@:@") = 0 Then Throw New RuntimeException("Could not register outline expansion")
    If MacAddMethod(cls, MacSelector("outlineViewItemDidCollapse:"), CType(expanded, Ptr), "v@:@") = 0 Then Throw New RuntimeException("Could not register outline collapse")
    Dim display As TreeMacDisplay = AddressOf TreeMacDisplayCell
    If MacAddMethod(cls, MacSelector("outlineView:willDisplayCell:forTableColumn:item:"), CType(display, Ptr), "v@:@@@@") = 0 Then Throw New RuntimeException("Could not register outline icons")
    MacRegisterClass(cls)
    Return cls
End Function
Private Function TreeMacOwner(receiver As Ptr) As TreeView
    For Each reference As TreeReference In TreeRegistry.Items
        Dim owner As TreeView = reference.Owner
        If owner <> Nil Then
            If owner.OwnsMacBridge(receiver) Then Return owner
        End If
    Next
    Return Nil
End Function
Private Function TreeMacNumber(receiver As Ptr, methodSelector As Ptr, outline As Ptr, item As Ptr) As Integer
    Dim owner As TreeView = TreeMacOwner(receiver)
    If owner = Nil Then Return 0
    Try
        Return owner.MacChildCount(item)
    Catch e As Exception
        owner.LastNativeError = e.Message
        Return 0
    End Try
End Function
Private Function TreeMacGetChild(receiver As Ptr, methodSelector As Ptr, outline As Ptr, index As Integer, item As Ptr) As Ptr
    Dim owner As TreeView = TreeMacOwner(receiver)
    If owner = Nil Then Return Nil
    Try
        Return owner.MacChild(index, item)
    Catch e As Exception
        owner.LastNativeError = e.Message
        Return Nil
    End Try
End Function
Private Function TreeMacCanExpand(receiver As Ptr, methodSelector As Ptr, outline As Ptr, item As Ptr) As UInt8
    Dim owner As TreeView = TreeMacOwner(receiver)
    If owner = Nil Then Return 0
    Try
        If owner.MacChildCount(item) > 0 Then Return 1
    Catch e As Exception
        owner.LastNativeError = e.Message
    End Try
    Return 0
End Function
Private Function TreeMacGetValue(receiver As Ptr, methodSelector As Ptr, outline As Ptr, column As Ptr, item As Ptr) As Ptr
    Dim owner As TreeView = TreeMacOwner(receiver)
    If owner = Nil Then Return Nil
    Try
        Return owner.MacCaption(item)
    Catch e As Exception
        owner.LastNativeError = e.Message
        Return Nil
    End Try
End Function
Private Sub TreeMacSelected(receiver As Ptr, methodSelector As Ptr, notification As Ptr)
    Dim owner As TreeView = TreeMacOwner(receiver)
    If owner <> Nil Then owner.NativeSelectionChanged()
End Sub
Private Sub TreeMacExpanded(receiver As Ptr, methodSelector As Ptr, notification As Ptr)
    Dim owner As TreeView = TreeMacOwner(receiver)
    If owner = Nil Then Return
    Try
        owner.MacExpansionChanged(notification)
    Catch e As Exception
        owner.LastNativeError = e.Message
    End Try
End Sub
