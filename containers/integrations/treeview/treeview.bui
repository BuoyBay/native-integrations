Private Function TreeGTKChildren(item As Ptr, data As Ptr) As Ptr
    Dim owner As TreeView = TreeOwner(data)
    If owner = Nil Then Return Nil
    Try
        Return owner.GTKChildren(item)
    Catch e As Exception
        owner.LastNativeError = e.Message
        Return Nil
    End Try
End Function
Private Sub TreeGTKSelected(object As Ptr, detail As Ptr, data As Ptr)
    Dim owner As TreeView = TreeOwner(data)
    If owner <> Nil Then owner.NativeSelectionChanged()
End Sub
Private Delegate Function TreeGTKKeyboardSignal(controller As Ptr, key As UInt32, code As UInt32, state As UInt32, data As Ptr) As Int32
Private Optional Declare Function GTKKeyboardScrollChild Lib "libgtk-4.so.1" Alias "gtk_scrolled_window_get_child" (scroll As Ptr) As Ptr
Private Optional Declare Function GTKKeyboardGrabFocus Lib "libgtk-4.so.1" Alias "gtk_widget_grab_focus" (widget As Ptr) As Int32
Private Optional Declare Function GTKKeyboardNew Lib "libgtk-4.so.1" Alias "gtk_event_controller_key_new" () As Ptr
Private Optional Declare Sub GTKKeyboardPhase Lib "libgtk-4.so.1" Alias "gtk_event_controller_set_propagation_phase" (controller As Ptr, phase As Int32)
Private Optional Declare Function GTKKeyboardConnect Lib "libgobject-2.0.so.0" Alias "g_signal_connect_data" (object As Ptr, signal As String, callback As TreeGTKKeyboardSignal, data As Ptr, destroy As Ptr, connectFlags As Int32) As UInt64
Private Optional Declare Function GTKKeyboardRoot Lib "libgtk-4.so.1" Alias "gtk_widget_get_root" (widget As Ptr) As Ptr
Private Optional Declare Function GTKKeyboardFocus Lib "libgtk-4.so.1" Alias "gtk_window_get_focus" (window As Ptr) As Ptr
Private Optional Declare Function GTKKeyboardAncestor Lib "libgtk-4.so.1" Alias "gtk_widget_is_ancestor" (widget As Ptr, ancestor As Ptr) As Int32
Private Function TreeGTKKeyboard(controller As Ptr, key As UInt32, code As UInt32, state As UInt32, data As Ptr) As Int32
    Dim owner As TreeView = TreeOwner(data)
    If owner = Nil Then Return 0
    Try
        Dim name As String = ""
        Select Case key
            Case 65383
                name = "Menu"
            Case 65479
                name = "F10"
            Case 65471
                name = "F2"
            Case 68, 100
                name = "D"
        End Select
        Dim primary As Boolean = (state And 4) <> 0
        Dim shift As Boolean = (state And 1) <> 0
        Dim alt As Boolean = (state And 8) <> 0 Or (state And 67108864) <> 0
        If owner.NavigationKey(name, primary, shift, alt) Then Return 1
    Catch e As Exception
        owner.LastNativeError = e.Message
    End Try
    Return 0
End Function
Private Delegate Sub TreeGTKContextSignal(gesture As Ptr, presses As Int32, x As Double, y As Double, data As Ptr)
Private Optional Declare Function GTKConnectContext Lib "libgobject-2.0.so.0" Alias "g_signal_connect_data" (object As Ptr, signal As String, callback As TreeGTKContextSignal, data As Ptr, destroy As Ptr, connectFlags As Int32) As UInt64
Private Optional Declare Function GTKContextGesture Lib "libgtk-4.so.1" Alias "gtk_gesture_click_new" () As Ptr
Private Optional Declare Sub GTKContextButton Lib "libgtk-4.so.1" Alias "gtk_gesture_single_set_button" (gesture As Ptr, button As UInt32)
Private Optional Declare Sub GTKContextController Lib "libgtk-4.so.1" Alias "gtk_widget_add_controller" (widget As Ptr, controller As Ptr)
Private Optional Declare Function GTKContextWidget Lib "libgtk-4.so.1" Alias "gtk_event_controller_get_widget" (controller As Ptr) As Ptr
Private Optional Declare Function GTKContextPoint Lib "libgtk-4.so.1" Alias "gtk_widget_translate_coordinates" (source As Ptr, destination As Ptr, x As Double, y As Double, ByRef destX As Double, ByRef destY As Double) As Int32
Private Sub TreeGTKContext(gesture As Ptr, presses As Int32, x As Double, y As Double, data As Ptr)
    Dim owner As TreeView = TreeOwner(data)
    If owner = Nil Then Return
    Try
        owner.GTKContext(GTKContextWidget(gesture), x, y)
    Catch e As Exception
        owner.LastNativeError = e.Message
    End Try
End Sub
Private Sub TreeGTKSetup(object As Ptr, item As Ptr, data As Ptr)
    Dim owner As TreeView = TreeOwner(data)
    If owner = Nil Then Return
    Try
        GTKListFocusable(item, 0)
        Dim expander As Ptr = GTKExpander()
        Dim label As Ptr = GTKLabelNew("")
        GTKLabelAlignment(label, 0.0)
        Dim box As Ptr = GTKBox(0, 6)
        Dim image As Ptr = GTKImage()
        GTKSize(image, 20, 20)
        GTKBoxAppend(box, image)
        GTKBoxAppend(box, label)
        GTKExpanderSetChild(expander, box)
        GTKListSetChild(item, expander)
        Dim gesture As Ptr = GTKContextGesture()
        GTKContextButton(gesture, 3)
        GTKConnectContext(gesture, "pressed", AddressOf TreeGTKContext, data, Nil, 0)
        GTKContextController(expander, gesture)
    Catch e As Exception
        owner.LastNativeError = e.Message
    End Try
End Sub
Private Sub TreeGTKBind(object As Ptr, item As Ptr, data As Ptr)
    Dim owner As TreeView = TreeOwner(data)
    If owner = Nil Then Return
    Try
        owner.GTKBindItem(item)
    Catch e As Exception
        owner.LastNativeError = e.Message
    End Try
End Sub
Private Sub TreeGTKUnbind(object As Ptr, item As Ptr, data As Ptr)
    Dim owner As TreeView = TreeOwner(data)
    If owner = Nil Then Return
    Try
        Dim oldRow As Ptr = GTKData(GTKListChild(item), "buoy-context-row")
        If oldRow <> Nil Then GTKSetData(oldRow, "buoy-context-widget", Nil)
        GTKSetData(GTKListChild(item), "buoy-context-row", Nil)
        GTKExpanderRow(GTKListChild(item), Nil)
    Catch e As Exception
        owner.LastNativeError = e.Message
    End Try
End Sub
Private Sub TreeGTKExpanded(row As Ptr, detail As Ptr, data As Ptr)
    Dim owner As TreeView = TreeOwner(data)
    If owner = Nil Then Return
    Try
        owner.GTKExpansionChanged(row)
    Catch e As Exception
        owner.LastNativeError = e.Message
    End Try
End Sub
