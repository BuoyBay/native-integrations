Private Function TreeWide(value As String) As Bytes
    Dim bytes As Bytes = value.AsUTF16LE()
    bytes.Append(0)
    bytes.Append(0)
    Return bytes
End Function
Private Function TreeWinMessage(widget As Ptr, message As UInt32, word As UInt64, param As Ptr, id As UInt64, data As UInt64) As Int64
    If message = 130 Then ' WM_NCDESTROY invalidates HWNDs before they can be recycled.
        Dim callbackID As Integer = id
        Dim owner As TreeView = TreeOwner(CType(callbackID, Ptr))
        If owner <> Nil Then owner.WindowsDestroyed(widget)
    End If
    If message = 256 Or message = 260 Then ' WM_KEYDOWN / WM_SYSKEYDOWN
        Dim keyID As Integer = id
        Dim owner As TreeView = TreeOwner(CType(keyID, Ptr))
        If owner <> Nil Then
            If owner.OwnsNativeWidget(widget) Then
                Try
                    Dim name As String = ""
                    Select Case word
                        Case 93
                            name = "Menu"
                        Case 121
                            name = "F10"
                        Case 113
                            name = "F2"
                        Case 68
                            name = "D"
                    End Select
                    If owner.NavigationKey(name, WinKeyboardState(17) < 0, WinKeyboardState(16) < 0, WinKeyboardState(18) < 0 Or WinKeyboardState(91) < 0 Or WinKeyboardState(92) < 0) Then Return 0
                Catch e As Exception
                    owner.LastNativeError = e.Message
                End Try
            End If
        End If
    End If
    If message = 78 And param <> Nil Then ' WM_NOTIFY
        Dim callbackID As Integer = id
        Dim owner As TreeView = TreeOwner(CType(callbackID, Ptr))
        If owner <> Nil Then
            Try
                Dim header As TreeNotifyHeader
                WinCopy(CType(header, Ptr), param, 24)
                If owner.OwnsNativeWidget(header.Window) Then
                    If header.Code = -5 Then owner.WindowsContextFromCursor() ' NM_RCLICK
                    If header.Code = -451 Then owner.NativeSelectionChanged() ' TVN_SELCHANGEDW
                    If header.Code = -455 Then
                        Dim notification As TreeNotify
                        WinCopy(CType(notification, Ptr), param, 152)
                        owner.WindowsExpansionChanged(notification.NewItem.Handle)
                    End If
                End If
            Catch e As Exception
                owner.LastNativeError = e.Message
            End Try
        End If
    End If
    Return WinDefault(widget, message, word, CType(param, Integer))
End Function
