Private Declare Function MacKeyboardCode Lib "AppKit" Selector "keyCode" (nativeEvent As Ptr) As UInt16
Private Declare Function MacKeyboardModifiers Lib "AppKit" Selector "modifierFlags" (nativeEvent As Ptr) As UInt64
Private Declare Function MacKeyboardWindow Lib "AppKit" Selector "window" (view As Ptr) As Ptr
