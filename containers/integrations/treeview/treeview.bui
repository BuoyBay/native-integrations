' Native tree/outline control. All UI calls must occur on the GUI thread.
Public Class TreeNode
    Private Property mCaption As String = ""
    Private Property mIconPath As String = ""
    Private Property mChildren As Array Of TreeNode = []
    Private Property mParent As Weak TreeNode
    Private Property mOwner As Weak TreeView
    Public Property Tag As String = ""
    ' Initial expansion state; use TreeView.SetExpanded after opening.
    Public Property Expanded As Boolean = False

    Public Sub Constructor(caption As String = "")
        Me.mCaption = caption
    End Sub
    Public Property Caption As String
        Get
            Return Me.mCaption
        End Get
        Set
            Me.mCaption = value
            Dim owner As TreeView = Me.mOwner
            If owner <> Nil Then owner.Reload()
        End Set
    End Property
    ''' Optional native image file: PNG on macOS/Linux, ICO on Windows.
    Public Property IconPath As String
        Get
            Return Me.mIconPath
        End Get
        Set
            If value = Me.mIconPath Then Return
            Me.mIconPath = value
            Dim owner As TreeView = Me.mOwner
            If owner <> Nil Then owner.Reload()
        End Set
    End Property
    Public Property ParentNode As TreeNode
        Get
            Return Me.mParent
        End Get
    End Property
    Public Property OwnerTree As TreeView
        Get
            Return Me.mOwner
        End Get
    End Property
    Public Property ChildCount As Integer
        Get
            Return Array.Count(Me.mChildren)
        End Get
    End Property
    Public Function ChildAt(index As Integer) As TreeNode
        If index < 0 Or index >= Me.ChildCount Then Throw New OutOfBoundsException("Invalid child index")
        Return Me.mChildren(index)
    End Function
    Public Function Contains(node As TreeNode) As Boolean
        If Me Is node Then Return True
        For Each child As TreeNode In Me.mChildren
            If child.Contains(node) Then Return True
        Next
        Return False
    End Function
    Public Sub AddChild(node As TreeNode)
        If node = Nil Then Throw New InvalidArgumentException("Child cannot be Nil")
        If node.Contains(Me) Then Throw New InvalidArgumentException("Tree cycles are not allowed")
        If node.mParent <> Nil Or node.mOwner <> Nil Then Throw New InvalidArgumentException("Detach the node before adding it")
        node.mParent = Me
        node.AttachTree(Me.mOwner)
        Array.Append(Me.mChildren, node)
        Dim owner As TreeView = Me.mOwner
        If owner <> Nil Then owner.Reload()
    End Sub
    Public Sub RemoveChild(node As TreeNode)
        For i As Integer = 0 To Me.ChildCount - 1
            If Me.mChildren(i) Is node Then
                Array.RemoveAt(Me.mChildren, i)
                node.mParent = Nil
                node.AttachTree(Nil)
                Dim owner As TreeView = Me.mOwner
                If owner <> Nil Then owner.Reload()
                Return
            End If
        Next
        Throw New InvalidArgumentException("Node is not an immediate child")
    End Sub
    ' Integration plumbing: applications should use AddRoot/AddChild instead.
    Public Sub AttachTree(owner As TreeView)
        Me.mOwner = owner
        For Each child As TreeNode In Me.mChildren
            child.AttachTree(owner)
        Next
    End Sub
End Class

Private Class TreeReference
    Public Property Owner As Weak TreeView
End Class
Private Class TreeRegistry
    Public Shared Property Items As Array Of TreeReference = []
End Class

Public Class TreeView Inherits View
    Event SelectionChanged(node As TreeNode)
    Event ContextRequested(node As TreeNode, location As Point)
    Event KeyboardCommand(node As TreeNode, command As String)
    Public Property NavigatorShortcuts As Boolean = False
    Private Property mRoots As Array Of TreeNode = []
    Private Property mNodes As Array Of TreeNode = []
    Private Property mItems As Array Of Ptr = []
    Private Property mSelected As TreeNode
    Private Property mHost As Ptr = Nil
    Private Property mWidget As Ptr = Nil
    Private Property mID As Integer = -1
    Private Property mNativeHostDestroyed As Boolean = False
    Private Property mUpdating As Boolean = False
    Public Property LastNativeError As String = ""
    Private Property mIndentation As Integer = 16
    Private Property mIconSize As Integer = 20

    ''' Logical row indentation; changing it preserves node identity and selection.
    Public Property Indentation As Integer
        Get
            Return Me.mIndentation
        End Get
        Set
            If value < 0 Or value > 64 Then Throw New InvalidArgumentException("Tree indentation must be between 0 and 64")
            If value = Me.mIndentation Then Return
            Me.mIndentation = value
            Me.Reload()
        End Set
    End Property

    ''' Logical icon side length. Files are scaled by the native image control.
    Public Property IconSize As Integer
        Get
            Return Me.mIconSize
        End Get
        Set
            If value < 12 Or value > 48 Then Throw New InvalidArgumentException("Tree icon size must be between 12 and 48")
            If value = Me.mIconSize Then Return
            Me.mIconSize = value
            Me.Reload()
        End Set
    End Property

    Private Property mShowsFocusRing As Boolean = True

    ''' Whether the macOS outline draws the system focus ring while it holds keyboard
    ''' focus. The selected row's highlight still tracks focus either way.
    Public Property ShowsFocusRing As Boolean
        Get
            Return Me.mShowsFocusRing
        End Get
        Set
            If value = Me.mShowsFocusRing Then Return
            Me.mShowsFocusRing = value
            #If TargetMac Then
                If Me.mOutline <> Nil Then Me.ApplyMacFocusRing()
            #End If
        End Set
    End Property
    Private Property mCompactInsets As Boolean = False

    ''' When True the macOS outline drops the automatic (inset) table style's side
    ''' padding and the horizontal cell spacing, so level-0 rows start near the edge.
    Public Property CompactInsets As Boolean
        Get
            Return Me.mCompactInsets
        End Get
        Set
            If value = Me.mCompactInsets Then Return
            Me.mCompactInsets = value
            #If TargetMac Then
                If Me.mOutline <> Nil Then Me.ApplyMacFocusRing()
            #End If
        End Set
    End Property
    #If TargetMac Then
        ''' Focus ring and inset styling (ShowsFocusRing, CompactInsets).
        Private Sub ApplyMacFocusRing()
            ' NSFocusRingTypeDefault = 0, NSFocusRingTypeNone = 1.
            Dim ringType As Integer = 0
            If Not Me.mShowsFocusRing Then ringType = 1
            MacFocusRingType(Me.mOutline, ringType)
            MacFocusRingType(Me.mWidget, ringType)
            ' NSTableViewStyleAutomatic = 0 resolves to Inset; FullWidth = 1.
            Dim spacing As TreeIconSize
            spacing.Height = 2.0
            If Me.mCompactInsets Then
                MacTableStyle(Me.mOutline, 1)
                spacing.Width = 0.0
            Else
                MacTableStyle(Me.mOutline, 0)
                spacing.Width = 3.0
            End If
            MacIntercellSpacing(Me.mOutline, spacing)
        End Sub
    #End If
    #If TargetLinux Then
        Private Property mRootModel As Ptr = Nil
        Private Property mTreeModel As Ptr = Nil
        Private Property mSelection As Ptr = Nil
        Private Property mChildModels As Array Of Ptr = []
    #ElseIf TargetMac Then
        Private Property mMacIcons As Array Of Ptr = []
        Private Property mOutline As Ptr = Nil
        Private Property mBridge As Ptr = Nil
    #ElseIf TargetWindows Then
        Private Property mImageList As Ptr = Nil
    #End If

    Public Property RootCount As Integer
        Get
            Return Array.Count(Me.mRoots)
        End Get
    End Property
    Public Function RootAt(index As Integer) As TreeNode
        If index < 0 Or index >= Me.RootCount Then Throw New OutOfBoundsException("Invalid root index")
        Return Me.mRoots(index)
    End Function
    Public Function Contains(node As TreeNode) As Boolean
        If node = Nil Then Return False
        For Each root As TreeNode In Me.mRoots
            If root.Contains(node) Then Return True
        Next
        Return False
    End Function
    Public Sub AddRoot(node As TreeNode)
        If node = Nil Then Throw New InvalidArgumentException("Root cannot be Nil")
        If node.ParentNode <> Nil Or node.OwnerTree <> Nil Then Throw New InvalidArgumentException("Detach the node before adding it")
        node.AttachTree(Me)
        Array.Append(Me.mRoots, node)
        Me.Reload()
    End Sub
    Public Sub RemoveRoot(node As TreeNode)
        For i As Integer = 0 To Me.RootCount - 1
            If Me.mRoots(i) Is node Then
                Array.RemoveAt(Me.mRoots, i)
                node.AttachTree(Nil)
                Me.Reload()
                Return
            End If
        Next
        Throw New InvalidArgumentException("Node is not an immediate root")
    End Sub
    Public Sub Clear()
        For Each node As TreeNode In Me.mRoots
            node.AttachTree(Nil)
        Next
        Array.Clear(Me.mRoots)
        Me.Reload()
    End Sub
    Public Property SelectedNode As TreeNode
        Get
            If Me.mID >= 0 And Not Me.mUpdating Then Me.mSelected = Me.ReadNativeSelection()
            Return Me.mSelected
        End Get
        Set
            If value <> Nil And Not Me.Contains(value) Then Throw New InvalidArgumentException("Selected node belongs to another tree")
            Me.mSelected = value
            Dim parents As Array Of TreeNode = []
            Dim parent As TreeNode
            If value <> Nil Then parent = value.ParentNode
            While parent <> Nil
                Array.Append(parents, parent)
                parent = parent.ParentNode
            End While
            For i As Integer = Array.LastIndex(parents) To 0 Step -1
                Me.SetExpanded(parents(i), True)
            Next
            If Me.mID >= 0 Then
                Me.mUpdating = True
                Me.ApplyNativeSelection()
                Me.mUpdating = False
            End If
        End Set
    End Property
    Public Sub SetExpanded(node As TreeNode, expanded As Boolean)
        If Not Me.Contains(node) Then Throw New InvalidArgumentException("Node belongs to another tree")
        node.Expanded = expanded
        If Me.mID < 0 Then Return
        Me.mUpdating = True
        #If TargetLinux Then
            Me.ApplyGTKExpansion()
        #ElseIf TargetWindows Then
            Dim item As Ptr = Me.ItemFor(node)
            Dim action As Integer = 1
            If expanded Then action = 2
            WinSend(Me.mWidget, 4354, action, CType(item, Integer))
        #ElseIf TargetMac Then
            Dim item As Ptr = Me.ItemFor(node)
            If expanded Then
                MacExpand(Me.mOutline, item, False)
            Else
                MacCollapse(Me.mOutline, item, False)
            End If
        #End If
        Me.mUpdating = False
    End Sub
    Public Function IsExpanded(node As TreeNode) As Boolean
        If Not Me.Contains(node) Then Throw New InvalidArgumentException("Node belongs to another tree")
        If Me.mID >= 0 Then
            #If TargetLinux Then
                Dim row As Ptr = Me.GTKRowFor(node)
                If row <> Nil Then
                    node.Expanded = GTKExpanded(row) <> 0
                    GTKUnref(row)
                End If
            #ElseIf TargetWindows Then
                node.Expanded = (WinSend(Me.mWidget, 4391, CType(Me.ItemFor(node), Integer), 32) And 32) <> 0
            #ElseIf TargetMac Then
                node.Expanded = MacExpanded(Me.mOutline, Me.ItemFor(node))
            #End If
        End If
        Return node.Expanded
    End Function
    Public Sub Open()
        If Me.mNativeHostDestroyed Then Throw New InvalidArgumentException("Create a new TreeView after native host destruction")
        Me.Close()
        Me.LastNativeError = ""
        Me.mHost = Me.NativeWidget
        If Me.mHost = Nil Then Throw New InvalidArgumentException("Attach TreeView before Open")
        #If TargetWindows Then
            If WinIsWindow(Me.mHost) = 0 Then Throw New InvalidArgumentException("Attach TreeView to a live window before Open")
        #End If
        For i As Integer = 0 To Array.LastIndex(TreeRegistry.Items)
            If TreeRegistry.Items(i).Owner = Nil Then
                Me.mID = i
                Exit For
            End If
        Next
        If Me.mID < 0 Then
            Me.mID = Array.Count(TreeRegistry.Items)
            Array.Append(TreeRegistry.Items, New TreeReference())
        End If
        TreeRegistry.Items(Me.mID).Owner = Me
        Try
            #If TargetWindows Then
                If WinSubclass(Me.mHost, AddressOf TreeWinMessage, Me.mID + 1, 0) = 0 Then Throw New RuntimeException("Could not bind tree container")
            #End If
            Me.Reload()
        Catch e As Exception
            Me.Close()
            Throw e
        End Try
    End Sub
    Public Sub Close()
        If Me.mID < 0 Then Return
        Me.CaptureState()
        TreeRegistry.Items(Me.mID).Owner = Nil
        Me.DestroyNative()
        #If TargetWindows Then
            WinUnsubclass(Me.mHost, AddressOf TreeWinMessage, Me.mID + 1)
        #End If
        Me.mHost = Nil
        Me.mID = -1
    End Sub
    Public Sub Destructor()
        Me.Close()
        For Each root As TreeNode In Me.mRoots
            root.AttachTree(Nil)
        Next
    End Sub
    Public Sub Reload()
        If Me.mID < 0 Then
            If Not Me.Contains(Me.mSelected) Then Me.mSelected = Nil
            Return
        End If
        Me.CaptureState()
        If Not Me.Contains(Me.mSelected) Then Me.mSelected = Nil
        Me.DestroyNative()
        Array.Clear(Me.mNodes)
        For Each root As TreeNode In Me.mRoots
            Me.Flatten(root)
        Next
        Me.mUpdating = True
        Try
            Me.BuildNative()
            Me.RefreshNative()
            Me.ApplyNativeSelection()
            Me.mUpdating = False
        Catch e As Exception
            Me.DestroyNative()
            Me.mUpdating = False
            Throw e
        End Try
    End Sub
    Private Sub Flatten(node As TreeNode)
        Array.Append(Me.mNodes, node)
        For i As Integer = 0 To node.ChildCount - 1
            Me.Flatten(node.ChildAt(i))
        Next
    End Sub
    Private Function ItemFor(node As TreeNode) As Ptr
        For i As Integer = 0 To Array.LastIndex(Me.mNodes)
            If Me.mNodes(i) Is node Then Return Me.mItems(i)
        Next
        Return Nil
    End Function
    Private Function NodeFor(item As Ptr) As TreeNode
        If item = Nil Then Return Nil
        For i As Integer = 0 To Array.LastIndex(Me.mItems)
            If Me.mItems(i) = item Then Return Me.mNodes(i)
        Next
        Return Nil
    End Function
    Private Sub CaptureState()
        If Me.mWidget = Nil Then Return
        Me.mSelected = Me.ReadNativeSelection()
        For Each node As TreeNode In Me.mNodes
            If Me.Contains(node) Then Me.IsExpanded(node)
        Next
    End Sub
    Private Sub DestroyNative()
        Me.mUpdating = True
        #If TargetLinux Then
            If Me.mWidget <> Nil Then
                Dim parent As Ptr = GTKParent(Me.mWidget)
                If parent <> Nil Then GTKFixedRemove(parent, Me.mWidget)
                GTKUnref(Me.mWidget)
            End If
            If Me.mSelection <> Nil Then GTKUnref(Me.mSelection)
            If Me.mTreeModel <> Nil Then GTKUnref(Me.mTreeModel)
            If Me.mRootModel <> Nil Then GTKUnref(Me.mRootModel)
            For Each model As Ptr In Me.mChildModels
                GTKUnref(model)
            Next
            For Each item As Ptr In Me.mItems
                GTKUnref(item)
            Next
            Me.mSelection = Nil
            Me.mTreeModel = Nil
            Me.mRootModel = Nil
            Array.Clear(Me.mChildModels)
        #ElseIf TargetWindows Then
            If Me.mWidget <> Nil Then WinDestroy(Me.mWidget)
            If Me.mImageList <> Nil Then WinImagesDestroy(Me.mImageList)
            Me.mImageList = Nil
        #ElseIf TargetMac Then
            If Me.mOutline <> Nil Then
                MacDataSource(Me.mOutline, Nil)
                MacDelegate(Me.mOutline, Nil)
            End If
            If Me.mWidget <> Nil Then
                MacRemove(Me.mWidget)
                MacRelease(Me.mWidget)
            End If
            If Me.mOutline <> Nil Then MacRelease(Me.mOutline)
            If Me.mBridge <> Nil Then MacRelease(Me.mBridge)
            For Each item As Ptr In Me.mItems
                MacRelease(item)
            Next
            For Each icon As Ptr In Me.mMacIcons
                If icon <> Nil Then MacRelease(icon)
            Next
            Array.Clear(Me.mMacIcons)
            Me.mOutline = Nil
            Me.mBridge = Nil
        #End If
        Me.mWidget = Nil
        Array.Clear(Me.mItems)
        Me.mUpdating = False
    End Sub
    Public Sub RefreshNative()
        If Me.mWidget = Nil Then Return
        #If TargetLinux Then
            GTKSize(Me.mWidget, Me.Width, Me.Height)
        #ElseIf TargetWindows Then
            Dim scale As Double = WinDPI(Me.mHost) / 96.0
            Dim width As Integer = Me.Width * scale
            Dim height As Integer = Me.Height * scale
            WinMove(Me.mWidget, 0, 0, width, height, 1)
        #ElseIf TargetMac Then
            Dim frame As TreeRect
            frame.X = 0
            frame.Y = 0
            frame.Width = Me.Width
            frame.Height = Me.Height
            MacFrame(Me.mWidget, frame)
        #End If
    End Sub
    Private Function ReadNativeSelection() As TreeNode
        If Me.mWidget = Nil Then Return Me.mSelected
        #If TargetLinux Then
            Dim row As Ptr = GTKSelectedItem(Me.mSelection)
            If row <> Nil Then Return Me.GTKNodeForRow(row)
        #ElseIf TargetWindows Then
            Dim address As Integer = WinSend(Me.mWidget, 4362, 9, 0)
            Return Me.NodeFor(CType(address, Ptr))
        #ElseIf TargetMac Then
            Dim row As Integer = MacSelectedRow(Me.mOutline)
            If row >= 0 Then Return Me.NodeFor(MacItemAtRow(Me.mOutline, row))
        #End If
        Return Nil
    End Function
    Private Sub ApplyNativeSelection()
        #If TargetLinux Then
            Dim position As Integer = 4294967295
            Dim count As Integer = GTKCount(Me.mTreeModel)
            For i As Integer = 0 To count - 1
                Dim row As Ptr = GTKGetRow(Me.mTreeModel, i)
                If Me.GTKNodeForRow(row) Is Me.mSelected Then position = i
                GTKUnref(row)
            Next
            GTKSelect(Me.mSelection, position)
        #ElseIf TargetWindows Then
            WinSend(Me.mWidget, 4363, 9, CType(Me.ItemFor(Me.mSelected), Integer))
        #ElseIf TargetMac Then
            If Me.mSelected = Nil Then
                MacDeselect(Me.mOutline, Me.mOutline)
            Else
                Dim row As Integer = MacRowForItem(Me.mOutline, Me.ItemFor(Me.mSelected))
                If row >= 0 Then MacSelect(Me.mOutline, MacIndexSet(MacClass("NSIndexSet"), row), False)
            End If
        #End If
    End Sub
    ' Select without notifying first: the host may rebuild the tree during selection.
    Public Sub RequestContext(node As TreeNode, location As Point)
        If node <> Nil And Not Me.Contains(node) Then Return
        Me.SelectedNode = node
        #If TargetWindows Then
            Me.FocusKeyboard()
        #End If
        RaiseEvent ContextRequested(node, location)
    End Sub

    ''' Focus belongs to the native tree or one of its native row children.
    Public Property HasKeyboardFocus As Boolean
        Get
            If Me.mWidget = Nil Then Return False
            #If TargetLinux Then
                Dim root As Ptr = GTKKeyboardRoot(Me.mWidget)
                If root = Nil Then Return False
                Dim focus As Ptr = GTKKeyboardFocus(root)
                If focus = Nil Then Return False
                Return focus = Me.mWidget Or GTKKeyboardAncestor(focus, Me.mWidget) <> 0
            #ElseIf TargetWindows Then
                Return WinKeyboardFocus() = Me.mWidget
            #ElseIf TargetMac Then
                Dim window As Ptr = MacKeyboardWindow(Me.mOutline)
                If window = Nil Then Return False
                Return MacKeyboardResponder(window) = Me.mOutline
            #End If
            Return False
        End Get
    End Property

    ''' Shared entry point for native key events and focus-aware menu routing.
    Public Function ActivateKeyboardCommand(command As String) As Boolean
        Dim node As TreeNode = Me.SelectedNode
        If node = Nil Then Return False
        If command = "context-menu" Then
            Me.RequestSelectedContext()
            Return True
        End If
        If Not Me.NavigatorShortcuts Then Return False
        If command <> "rename" And command <> "duplicate" Then Return False
        RaiseEvent KeyboardCommand(node, command)
        Return True
    End Function

    ''' Restore tree focus after a popup, without stealing focus from a clicked editor.
    Public Sub FocusKeyboard()
        #If TargetWindows Then
            If Me.mWidget <> Nil Then WinKeyboardSetFocus(Me.mWidget)
        #ElseIf TargetLinux Then
            Me.RestoreKeyboardFocus()
        #End If
    End Sub

    Public Sub RestoreKeyboardFocus()
        #If TargetLinux Then
            If Me.mWidget = Nil Then Return
            Dim list As Ptr = GTKKeyboardScrollChild(Me.mWidget)
            If list <> Nil Then GTKKeyboardGrabFocus(list)
        #End If
    End Sub

    Public Function NavigationKey(key As String, primary As Boolean, shift As Boolean, alt As Boolean) As Boolean
        If alt Then Return False
        If key = "Menu" And Not primary And Not shift Then Return Me.ActivateKeyboardCommand("context-menu")
        If key = "F10" And shift And Not primary Then Return Me.ActivateKeyboardCommand("context-menu")
        If key = "F2" And Not primary And Not shift Then Return Me.ActivateKeyboardCommand("rename")
        #If TargetMac Then
            If key = "Return" And Not primary And Not shift Then Return Me.ActivateKeyboardCommand("rename")
        #End If
        If key = "D" And primary And Not shift Then Return Me.ActivateKeyboardCommand("duplicate")
        Return False
    End Function

    Public Sub RequestSelectedContext()
        Dim node As TreeNode = Me.SelectedNode
        If node = Nil Then Return
        Dim location As Point = { X: 12.0, Y: 12.0 }
        #If TargetLinux Then
            Dim row As Ptr = Me.GTKRowFor(node)
            If row <> Nil Then
                Dim widget As Ptr = GTKData(row, "buoy-context-widget")
                If widget <> Nil Then
                    Dim x As Double
                    Dim y As Double
                    If GTKContextPoint(widget, Me.mHost, 12.0, Math.Max(22, Me.mIconSize + 4), x, y) <> 0 Then
                        location.X = x
                        location.Y = y
                    End If
                End If
                GTKUnref(row)
            End If
        #ElseIf TargetWindows Then
            Dim itemRect As TreeKeyboardItemRect
            itemRect.Item = Me.ItemFor(node)
            If WinSend(Me.mWidget, 4356, 1, CType(CType(itemRect, Ptr), Integer)) <> 0 Then
                Dim bounds As TreeKeyboardRect
                WinCopy(CType(bounds, Ptr), CType(itemRect, Ptr), 16)
                Dim scale As Double = WinDPI(Me.mHost) / 96.0
                location.X = bounds.Left / scale
                location.Y = bounds.Bottom / scale
            End If
        #ElseIf TargetMac Then
            Dim row As Integer = MacRowForItem(Me.mOutline, Me.ItemFor(node))
            If row >= 0 Then
                Dim bounds As TreeRect = MacKeyboardRowRect(Me.mOutline, row)
                Dim point As TreeContextPoint
                point.X = bounds.X + 12
                point.Y = bounds.Y + bounds.Height
                Dim local As TreeContextPoint = MacContextConvert(Me.mHost, point, Me.mOutline)
                location.X = local.X
                location.Y = local.Y
            End If
        #End If
        Me.RequestContext(node, location)
    End Sub

    Public Function OwnsNativeWidget(widget As Ptr) As Boolean
        Return Me.mWidget = widget
    End Function
    Public Sub NativeSelectionChanged()
        If Me.mUpdating Or Me.mID < 0 Then Return
        Try
            Me.mSelected = Me.ReadNativeSelection()
            RaiseEvent SelectionChanged(Me.mSelected)
        Catch e As Exception
            Me.LastNativeError = e.Message
        End Try
    End Sub
    Private Sub BuildNative()
        #If TargetLinux Then
            For Each node As TreeNode In Me.mNodes
                Array.Append(Me.mItems, GTKString(node.Caption))
                Array.Append(Me.mChildModels, GTKStore(GTKStringType()))
            Next
            For i As Integer = 0 To Array.LastIndex(Me.mNodes)
                Dim node As TreeNode = Me.mNodes(i)
                For child As Integer = 0 To node.ChildCount - 1
                    GTKAppend(Me.mChildModels(i), Me.ItemFor(node.ChildAt(child)))
                Next
            Next
            Me.mRootModel = GTKStore(GTKStringType())
            For Each root As TreeNode In Me.mRoots
                GTKAppend(Me.mRootModel, Me.ItemFor(root))
            Next
            Me.mTreeModel = GTKTree(GTKRef(Me.mRootModel), 0, 0, AddressOf TreeGTKChildren, CType(Me.mID + 1, Ptr), Nil)
            Me.mSelection = GTKSelection(GTKRef(Me.mTreeModel))
            GTKAutoselect(Me.mSelection, 0)
            GTKCanUnselect(Me.mSelection, 1)
            GTKSelect(Me.mSelection, 4294967295)
            GTKConnect(Me.mSelection, "notify::selected-item", AddressOf TreeGTKSelected, CType(Me.mID + 1, Ptr), Nil, 0)
            Dim factory As Ptr = GTKFactory()
            GTKConnect(factory, "setup", AddressOf TreeGTKSetup, CType(Me.mID + 1, Ptr), Nil, 0)
            GTKConnect(factory, "bind", AddressOf TreeGTKBind, CType(Me.mID + 1, Ptr), Nil, 0)
            GTKConnect(factory, "unbind", AddressOf TreeGTKUnbind, CType(Me.mID + 1, Ptr), Nil, 0)
            Dim list As Ptr = GTKList(GTKRef(Me.mSelection), factory)
            Dim keys As Ptr = GTKKeyboardNew()
            GTKKeyboardPhase(keys, 1)
            GTKKeyboardConnect(keys, "key-pressed", AddressOf TreeGTKKeyboard, CType(Me.mID + 1, Ptr), Nil, 0)
            GTKContextController(list, keys)
            Me.mWidget = GTKScroll()
            GTKRefSink(Me.mWidget)
            GTKScrollPolicy(Me.mWidget, 1, 1)
            GTKScrollChild(Me.mWidget, list)
            GTKFixedPut(Me.mHost, Me.mWidget, 0, 0)
            Me.ApplyGTKExpansion()
        #ElseIf TargetWindows Then
            Dim controls As TreeCommonControls
            controls.Size = 8
            controls.Classes = 2 ' ICC_TREEVIEW_CLASSES
            If WinInitControls(controls) = 0 Then Throw New RuntimeException("Could not initialize TreeView common control")
            Dim cls As Bytes = TreeWide("SysTreeView32")
            Me.mWidget = WinCreate(512, cls.DataPtr(), Nil, 1342242855, 0, 0, 1, 1, Me.mHost, Nil, Nil, Nil)
            If Me.mWidget = Nil Then Throw New RuntimeException("Could not create Win32 TreeView")
            If WinSubclass(Me.mWidget, AddressOf TreeWinMessage, Me.mID + 1, 0) = 0 Then Throw New RuntimeException("Could not monitor native TreeView lifetime")
            WinSend(Me.mWidget, 48, WinStockFont(17), 1)
            WinSend(Me.mWidget, 4359, Me.mIndentation, 0) ' TVM_SETINDENT
            WinSend(Me.mWidget, 4379, Math.Max(22, Me.mIconSize + 4), 0) ' TVM_SETITEMHEIGHT
            Me.mImageList = WinImages(Me.mIconSize, Me.mIconSize, 32, 0, 16)
            If Me.mImageList <> Nil Then WinSend(Me.mWidget, 4361, 0, CType(Me.mImageList, Integer))
            For Each node As TreeNode In Me.mNodes
                Dim text As Bytes = TreeWide(node.Caption)
                Dim insert As TreeInsert
                insert.Parent = CType(-65536, Ptr) ' TVI_ROOT
                If node.ParentNode <> Nil Then insert.Parent = Me.ItemFor(node.ParentNode)
                insert.After = CType(-65534, Ptr) ' TVI_LAST
                insert.Item.Mask = 65 ' TVIF_TEXT | TVIF_CHILDREN
                If node.IconPath <> "" And Me.mImageList <> Nil Then
                    Dim iconFileName As Bytes = TreeWide(node.IconPath)
                    Dim icon As Ptr = WinLoadImage(Nil, iconFileName.DataPtr(), 1, Me.mIconSize, Me.mIconSize, 16)
                    If icon <> Nil Then
                        Dim imageIndex As Int32 = WinImagesAdd(Me.mImageList, -1, icon)
                        WinIconDestroy(icon)
                        If imageIndex >= 0 Then
                            insert.Item.Mask = insert.Item.Mask Or 34
                            insert.Item.Image = imageIndex
                            insert.Item.SelectedImage = imageIndex
                        End If
                    End If
                End If
                insert.Item.Text = text.DataPtr()
                insert.Item.Children = 0
                If node.ChildCount > 0 Then insert.Item.Children = 1
                Dim address As Integer = WinSend(Me.mWidget, 4402, 0, CType(CType(insert, Ptr), Integer))
                If address = 0 Then Throw New RuntimeException("Could not insert native tree node")
                Array.Append(Me.mItems, CType(address, Ptr))
            Next
            For Each node As TreeNode In Me.mNodes
                If node.Expanded Then WinSend(Me.mWidget, 4354, 2, CType(Me.ItemFor(node), Integer))
            Next
        #ElseIf TargetMac Then
            For Each node As TreeNode In Me.mNodes
                Array.Append(Me.mItems, MacInit(MacAlloc(MacClass("NSObject"))))
                Dim icon As Ptr = Nil
                If node.IconPath <> "" Then icon = MacImageFile(MacAlloc(MacClass("NSImage")), MacString(MacClass("NSString"), node.IconPath))
                If icon <> Nil Then
                    Dim logicalSize As TreeIconSize
                    logicalSize.Width = Me.mIconSize
                    logicalSize.Height = Me.mIconSize
                    MacImageSize(icon, logicalSize)
                End If
                Array.Append(Me.mMacIcons, icon)
            Next
            Me.mBridge = MacInit(MacAlloc(TreeMacBridgeClass()))
            Me.mWidget = MacInit(MacAlloc(MacClass("NSScrollView")))
            Me.mOutline = MacInit(MacAlloc(TreeContextOutlineClass()))
            Dim column As Ptr = MacColumnInit(MacAlloc(MacClass("NSTableColumn")), MacString(MacClass("NSString"), "tree"))
            MacColumnWidth(column, Math.Max(20, Me.Width - 20))
            Dim cell As Ptr = MacCellText(MacAlloc(MacClass("NSBrowserCell")), MacString(MacClass("NSString"), ""))
            MacCellLeaf(cell, True)
            MacColumnCell(column, cell)
            MacRelease(cell)
            MacAddColumn(Me.mOutline, column)
            MacOutlineColumn(Me.mOutline, column)
            MacRelease(column)
            Dim outlineFrame As TreeRect
            outlineFrame.X = 0
            outlineFrame.Y = 0
            outlineFrame.Width = Me.Width
            outlineFrame.Height = Me.Height
            MacFrame(Me.mOutline, outlineFrame)
            MacAutoresizing(Me.mOutline, 2)
            MacHeader(Me.mOutline, Nil)
            MacRowHeight(Me.mOutline, Math.Max(22, Me.mIconSize + 4))
            MacIndentation(Me.mOutline, Me.mIndentation)
            Me.ApplyMacFocusRing()
            MacDataSource(Me.mOutline, Me.mBridge)
            MacDelegate(Me.mOutline, Me.mBridge)
            MacVerticalScroller(Me.mWidget, True)
            MacAutohideScrollers(Me.mWidget, True)
            MacDocumentView(Me.mWidget, Me.mOutline)
            MacAutoresizing(Me.mWidget, 18)
            MacAddSubview(Me.mHost, Me.mWidget)
            MacReload(Me.mOutline)
            For Each node As TreeNode In Me.mNodes
                If node.Expanded Then MacExpand(Me.mOutline, Me.ItemFor(node), False)
            Next
        #End If
    End Sub
    #If TargetLinux Then
        Public Function GTKChildren(item As Ptr) As Ptr
            For i As Integer = 0 To Array.LastIndex(Me.mItems)
                If Me.mItems(i) = item Then
                    If Me.mNodes(i).ChildCount = 0 Then Return Nil
                    Return GTKRef(Me.mChildModels(i))
                End If
            Next
            Return Nil
        End Function
        Private Function GTKNodeForRow(row As Ptr) As TreeNode
            If row = Nil Then Return Nil
            Dim item As Ptr = GTKRowItem(row)
            Dim node As TreeNode = Me.NodeFor(item)
            If item <> Nil Then GTKUnref(item)
            Return node
        End Function
        Private Function GTKRowFor(node As TreeNode) As Ptr
            For i As Integer = 0 To GTKCount(Me.mTreeModel) - 1
                Dim row As Ptr = GTKGetRow(Me.mTreeModel, i)
                If Me.GTKNodeForRow(row) Is node Then Return row
                GTKUnref(row)
            Next
            Return Nil
        End Function
        Private Sub ApplyGTKExpansion()
            Dim position As Integer = 0
            While position < GTKCount(Me.mTreeModel)
                Dim row As Ptr = GTKGetRow(Me.mTreeModel, position)
                Dim node As TreeNode = Me.GTKNodeForRow(row)
                If node <> Nil Then GTKSetExpanded(row, CType(node.Expanded, Int32))
                GTKUnref(row)
                position += 1
            End While
        End Sub
        Public Sub GTKContext(widget As Ptr, x As Double, y As Double)
            Dim row As Ptr = GTKData(widget, "buoy-context-row")
            Dim node As TreeNode = Me.GTKNodeForRow(row)
            If node = Nil Then Return
            Dim localX As Double
            Dim localY As Double
            If GTKContextPoint(widget, Me.mHost, x, y, localX, localY) = 0 Then Return
            Dim location As Point = { X: localX, Y: localY }
            Me.RequestContext(node, location)
        End Sub
        Public Sub GTKBindItem(item As Ptr)
            Dim row As Ptr = GTKListItem(item)
            Dim expander As Ptr = GTKListChild(item)
            Dim node As TreeNode = Me.GTKNodeForRow(row)
            If node = Nil Then Return
            Dim box As Ptr = GTKExpanderChild(expander)
            GTKLabel(GTKLastChild(box), node.Caption)
            Dim image As Ptr = GTKFirstChild(box)
            GTKExpanderIndentDepth(expander, 0)
            GTKMarginStart(expander, GTKRowDepth(row) * Me.mIndentation)
            GTKImagePixelSize(image, Me.mIconSize)
            GTKSize(image, Me.mIconSize, Me.mIconSize)
            If node.IconPath <> "" Then
                GTKImageFile(image, node.IconPath)
                GTKVisible(image, 1)
            Else
                GTKImageClear(image)
                GTKVisible(image, 0)
            End If
            GTKSetData(expander, "buoy-context-row", row)
            GTKSetData(row, "buoy-context-widget", expander)
            GTKExpanderRow(expander, row)
            If GTKData(row, "buoy-tree-watch") = Nil Then
                GTKSetData(row, "buoy-tree-watch", CType(Me.mID + 1, Ptr))
                GTKConnect(row, "notify::expanded", AddressOf TreeGTKExpanded, CType(Me.mID + 1, Ptr), Nil, 0)
            End If
        End Sub
        Public Sub GTKExpansionChanged(row As Ptr)
            If Me.mUpdating Then Return
            Dim node As TreeNode = Me.GTKNodeForRow(row)
            If node <> Nil Then node.Expanded = GTKExpanded(row) <> 0
        End Sub
    #ElseIf TargetWindows Then
        Public Sub WindowsContextFromCursor()
            Dim point As TreeNativePoint
            If WinContextCursor(point) = 0 Then Return
            If WinContextToClient(Me.mWidget, point) = 0 Then Return
            Me.WindowsContextAt(point.X, point.Y)
        End Sub
        Public Sub WindowsContext(coordinates As Integer)
            Me.WindowsContextAt(coordinates And 65535, (coordinates >> 16) And 65535)
        End Sub
        Public Sub WindowsContextAt(x As Integer, y As Integer)
            Dim hit As TreeContextHit
            hit.X = x
            hit.Y = y
            Dim item As Integer = WinSend(Me.mWidget, 4369, 0, CType(CType(hit, Ptr), Integer))
            Dim node As TreeNode = Me.NodeFor(CType(item, Ptr))
            If node = Nil Then Return
            Dim scale As Double = WinDPI(Me.mHost) / 96.0
            Dim location As Point = { X: hit.X / scale, Y: hit.Y / scale }
            Me.RequestContext(node, location)
        End Sub
        Public Sub WindowsDestroyed(widget As Ptr)
            ' The common control does not own its image list. External destruction
            ' clears mID below, so Close can no longer reach DestroyNative.
            If (widget = Me.mWidget Or widget = Me.mHost) And Not Me.mUpdating Then
                If Me.mImageList <> Nil Then WinImagesDestroy(Me.mImageList)
                Me.mImageList = Nil
            End If
            If widget = Me.mWidget Then
                Me.mWidget = Nil
                Array.Clear(Me.mItems)
                If Not Me.mUpdating Then
                    If Me.mID >= 0 Then
                        TreeRegistry.Items(Me.mID).Owner = Nil
                        WinUnsubclass(Me.mHost, AddressOf TreeWinMessage, Me.mID + 1)
                    End If
                    Me.mID = -1
                    Me.mHost = Nil
                    Me.mNativeHostDestroyed = True
                End If
            End If
            If widget = Me.mHost Then
                If Me.mID >= 0 Then TreeRegistry.Items(Me.mID).Owner = Nil
                Me.mID = -1
                Me.mWidget = Nil
                Me.mHost = Nil
                Me.mNativeHostDestroyed = True
                Array.Clear(Me.mItems)
            End If
        End Sub
        Public Sub WindowsExpansionChanged(item As Ptr)
            If Me.mUpdating Then Return
            Dim node As TreeNode = Me.NodeFor(item)
            If node <> Nil Then node.Expanded = (WinSend(Me.mWidget, 4391, CType(item, Integer), 32) And 32) <> 0
        End Sub
    #ElseIf TargetMac Then
        Public Function OwnsContextOutline(outline As Ptr) As Boolean
            Return Me.mOutline = outline
        End Function
        Public Sub MacContext(nativeEvent As Ptr)
            Dim point As TreeContextPoint = MacContextConvert(Me.mOutline, MacContextEventPoint(nativeEvent), Nil)
            Dim row As Integer = MacContextRow(Me.mOutline, point)
            If row < 0 Then Return
            Dim node As TreeNode = Me.NodeFor(MacItemAtRow(Me.mOutline, row))
            Dim local As TreeContextPoint = MacContextConvert(Me.mHost, point, Me.mOutline)
            Dim location As Point = { X: local.X, Y: local.Y }
            Me.RequestContext(node, location)
        End Sub
        Public Function OwnsMacBridge(bridge As Ptr) As Boolean
            Return Me.mBridge = bridge
        End Function
        Public Function MacChildCount(item As Ptr) As Integer
            If item = Nil Then Return Me.RootCount
            Dim node As TreeNode = Me.NodeFor(item)
            If node = Nil Then Return 0
            Return node.ChildCount
        End Function
        Public Function MacChild(index As Integer, item As Ptr) As Ptr
            If item = Nil Then Return Me.ItemFor(Me.RootAt(index))
            Dim node As TreeNode = Me.NodeFor(item)
            If node = Nil Then Return Nil
            Return Me.ItemFor(node.ChildAt(index))
        End Function
        Public Function MacCaption(item As Ptr) As Ptr
            Dim node As TreeNode = Me.NodeFor(item)
            If node = Nil Then Return Nil
            Return MacString(MacClass("NSString"), node.Caption)
        End Function
        Public Sub MacDisplayIcon(cell As Ptr, item As Ptr)
            For i As Integer = 0 To Array.LastIndex(Me.mItems)
                If Me.mItems(i) = item Then
                    MacCellImage(cell, Me.mMacIcons(i))
                    Return
                End If
            Next
            MacCellImage(cell, Nil)
        End Sub
        Public Sub MacExpansionChanged(notification As Ptr)
            If Me.mUpdating Then Return
            Dim info As Ptr = MacUserInfo(notification)
            Dim item As Ptr = MacObjectForKey(info, MacString(MacClass("NSString"), "NSObject"))
            Dim node As TreeNode = Me.NodeFor(item)
            If node <> Nil Then node.Expanded = MacExpanded(Me.mOutline, item)
        End Sub
    #End If
End Class

Private Function TreeOwner(data As Ptr) As TreeView
    Dim index As Integer = CType(data, Integer) - 1
    If index < 0 Or index >= Array.Count(TreeRegistry.Items) Then Return Nil
    Return TreeRegistry.Items(index).Owner
End Function

