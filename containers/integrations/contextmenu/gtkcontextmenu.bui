Private Optional Declare Function PopupWindowFocus Lib "libgtk-4.so.1" Alias "gtk_window_get_focus" (window As Ptr) As Ptr
Private Optional Declare Function PopupFocusAncestor Lib "libgtk-4.so.1" Alias "gtk_widget_is_ancestor" (widget As Ptr, ancestor As Ptr) As Int32
