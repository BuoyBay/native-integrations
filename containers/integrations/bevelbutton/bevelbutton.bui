Import bevelnative

Public Enum BevelButtonStyle As Integer
    PushButton
    ToggleButton
    StickyButton
End Enum
Public Enum BevelButtonBevel As Integer
    None
    Small
    Normal
    Large
    Rounded
    Round
    LargeRound
    Disclosure
End Enum
Public Enum BevelButtonCaptionPosition As Integer
    RightOfIcon
    LeftOfIcon
    AboveIcon
    BelowIcon
    Normal
    SystemDirection
End Enum
Public Enum BevelButtonCaptionAlignment As Integer
    Centered
    Left
    Right
    SystemDirection
End Enum
Public Enum BevelButtonIconAlignment As Integer
    Centered
    Left
    Right
    Top
    Bottom
    TopLeft
    BottomLeft
    TopRight
    BottomRight
    SystemDirection
End Enum
Public Enum BevelButtonMenuStyle As Integer
    None
    Down
    Right
End Enum
Public Enum BevelButtonAppearance As Integer
    System
    Light
    Dark
End Enum
Public Enum BevelButtonFontUnit As Integer
    Point
    Pixel
End Enum
Public Enum BevelButtonTextOverflow As Integer
    Clip
    Ellipsis
End Enum

' Measured in Buoy graphics points; also useful for custom drawing and tests.
Public Class BevelButtonLayout
    Public Property Text As String = ""
    Public Property TextX As Double
    Public Property TextY As Double
    Public Property TextWidth As Double
    Public Property TextHeight As Double
    Public Property IconX As Double
    Public Property IconY As Double
    Public Property IconWidth As Double
    Public Property IconHeight As Double
    Public Property ContentX As Double
    Public Property ContentY As Double
    Public Property ContentWidth As Double
    Public Property ContentHeight As Double
    Public Property MenuX As Double
    Public Property MenuWidth As Double
End Class

' Timer owns only a weak reference: no control/timer ARC cycle.
Private Class BevelButtonMonitor Inherits Timer
    Public Property Owner As Weak BevelButton
    Public Overrides Sub NotifyTick()
        Dim owner As BevelButton = Me.Owner
        If owner = Nil Then
            Me.Stop()
        Else
            owner.Synchronize()
        End If
    End Sub
End Class

' Native Buoy Canvas, MenuItem, accessibility and Event/Handle conventions.
Public Class BevelButton Inherits Canvas
    Event Action()
    Event Pressed()
    Event ValueChanged(newValue As Boolean)
    Event MenuOpening() As Boolean
    Event MenuSelected(item As MenuItem)
    Event FocusReceived()
    Event FocusLost()

    Private Property mMonitor As BevelButtonMonitor
    Private Property mTooltipBridge As BevelNativeTooltip
    Private Property mNative As BevelNativeState
    Private Property mPointerArmed As Boolean = False
    Private Property mMenuArmed As Boolean = False
    Private Property mKeyArmed As Boolean = False
    Private Property mActivationKey As KeyName = KeyName.Other
    Private Property mInside As Boolean = False
    Private Property mHadFocus As Boolean = False
    Private Property mWasEnabled As Boolean = True
    Private Property mWasVisible As Boolean = True
    Private Property mWasActive As Boolean = False
    Private Property mWasDark As Boolean = False
    Private Property mWasFocusable As Boolean = True
    Private Property mSynchronizing As Boolean = False
    Private Property mDisplayCaption As String = ""
    Private Property mMnemonic As String = ""
    Private Property mMnemonicIndex As Integer = -1
    Private Property mClosed As Boolean = False
    Private Property mLastNativeError As String = ""

    Public Sub Constructor()
        Super.Constructor()
        Me.Focusable = True
        Me.AccessibleRole = AccessibleRole.Button
        Me.mNative = New BevelNativeState()
        Me.mTooltipBridge = New BevelNativeTooltip()
        Me.mMonitor = New BevelButtonMonitor()
        Me.mMonitor.Owner = Me
        Me.mMonitor.Period = 50
        Me.mMonitor.Start()
    End Sub

    Public Sub Destructor()
        Me.Close()
    End Sub

    ' Optional early cleanup. The destructor performs the same cleanup.
    Public Sub Close()
        If Me.mClosed Then Return
        Me.mClosed = True
        Me.CancelPress()
        UnbindBevelMenus(CType(Me, Ptr))
        If Me.mMonitor <> Nil Then Me.mMonitor.Stop()
        If Me.mTooltipBridge <> Nil Then Me.mTooltipBridge.Close()
    End Sub
    Private Property mCaption As String = ""
    Public Property Caption As String
        Get
            Return Me.mCaption
        End Get
        Set
            Me.mCaption = value
            Me.ParseCaption()
            Me.UpdateAccessibleText()
            Me.Invalidate()
        End Set
